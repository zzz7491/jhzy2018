<view class="mall-page safe-top {{isSeniorMode ? 'senior-mode' : ''}}">

  <!-- 顶部栏 -->
  <view class="mall-header">
    <view class="header-left">
      <text class="page-title">积分激励</text>
      <text class="page-subtitle">志愿服务，温暖你我</text>
    </view>
    <view class="header-right">
      <!-- 圆形模式切换按钮 -->
      <view class="mode-toggle-btn" bindtap="toggleDisplayMode">
        <view class="mode-btn-inner {{isSeniorMode ? 'senior-active' : ''}}">
          <text class="mode-icon">{{isSeniorMode ? '👴' : '👦'}}</text>
        </view>
        <text class="mode-label">{{isSeniorMode ? '大字版' : '普通版'}}</text>
      </view>
    </view>
  </view>

  <!-- 积分概览卡片 -->
  <view class="points-overview-card">
    <view class="points-main">
      <text class="points-label">志愿服务积分</text>
      <text class="points-value">{{userPoints || 0}}</text>
      <text class="points-unit">分</text>
    </view>
    <view class="points-tips">
      <text class="tip-icon">✨</text>
      <text class="tip-text">每1积分 = 1小时志愿服务</text>
    </view>
    <view class="points-actions">
      <view class="action-item" bindtap="goToPointsDetail">
        <text class="action-icon">📊</text>
        <text class="action-text">积分明细</text>
      </view>
      <view class="action-divider"></view>
      <view class="action-item" bindtap="goToExchangeRecords">
        <text class="action-icon">📝</text>
        <text class="action-text">兑换记录</text>
      </view>
    </view>
  </view>

  <!-- 分类标签 -->
  <scroll-view class="category-scroll" scroll-x="true">
    <view class="category-list">
      <view class="category-item {{activeCategory === 0 ? 'active' : ''}}"
            bindtap="switchCategory" data-category="0">
        <text class="category-name">全部激励</text>
        <view class="category-badge" wx:if="{{activeCategory === 0}}"></view>
      </view>

      <view class="category-item {{activeCategory === 1 ? 'active' : ''}}"
            bindtap="switchCategory" data-category="1">
        <text class="category-name">生活用品</text>
        <view class="category-badge" wx:if="{{activeCategory === 1}}"></view>
      </view>

      <view class="category-item {{activeCategory === 2 ? 'active' : ''}}"
            bindtap="switchCategory" data-category="2">
        <text class="category-name">志愿纪念</text>
        <view class="category-badge" wx:if="{{activeCategory === 2}}"></view>
      </view>

      <view class="category-item {{activeCategory === 3 ? 'active' : ''}}"
            bindtap="switchCategory" data-category="3">
        <text class="category-name">虚拟权益</text>
        <view class="category-badge" wx:if="{{activeCategory === 3}}"></view>
      </view>

      <view class="category-item {{activeCategory === 4 ? 'active' : ''}}"
            bindtap="switchCategory" data-category="4">
        <text class="category-name">爱心回馈</text>
        <view class="category-badge" wx:if="{{activeCategory === 4}}"></view>
      </view>
    </view>
  </scroll-view>

  <!-- 激励物品网格 -->
  <view class="goods-section">
    <view class="section-title">
      <text class="title-text">志愿服务激励</text>
      <view class="title-line"></view>
      <text class="goods-count" wx:if="{{goodsList.length > 0}}">
        共{{goodsList.length}}个物品
      </text>
    </view>

    <view class="goods-grid" wx:if="{{goodsList.length > 0}}">
      <block wx:for="{{goodsList}}" wx:key="id">
        <view class="goods-card" catchtap="viewGoodsDetail" data-id="{{item.id}}">
          <!-- 商品图片区域 -->
          <view class="goods-image-container">
            <image class="goods-image" src="{{item.image || '/images/default-goods.png'}}" mode="aspectFill"></image>
            <!-- 库存状态 -->
            <view class="stock-badge {{item.inStock ? 'in-stock' : 'out-of-stock'}}">
              {{item.inStock ? '有库存' : '已兑完'}}
            </view>
            <!-- 热门标签 -->
            <view class="hot-badge" wx:if="{{item.is_hot}}">
              <text class="hot-icon">🔥</text>
              <text class="hot-text">热门</text>
            </view>
          </view>

          <!-- 商品信息 -->
          <view class="goods-info">
            <text class="goods-name">{{item.name}}</text>
            <text class="goods-desc">{{item.description}}</text>

            <view class="goods-footer">
              <!-- 物品来源 -->
              <view class="goods-source" wx:if="{{item.source}}">
                <text class="source-icon">🎁</text>
                <text class="source-text">来自: {{item.source}}</text>
              </view>

              <view class="footer-bottom">
                <view class="points-info">
                  <text class="points-icon">⭐</text>
                  <text class="points-value">{{item.points_required}}</text>
                  <text class="points-text">积分</text>
                </view>

                <view class="exchange-btn-container">
                  <button class="exchange-btn {{canExchange(item) ? '' : 'disabled'}}"
                          bindtap="exchangeGoods"
                          data-id="{{item.id}}"
                          hover-class="button-hover"
                          disabled="{{!canExchange(item)}}">
                    {{getExchangeBtnText(item)}}
                  </button>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{goodsList.length === 0 && !loading}}">
      <view class="empty-content">
        <text class="empty-icon">🎁</text>
        <text class="empty-title">暂无激励物品</text>
        <text class="empty-tips">更多激励物品正在筹备中</text>
        <button class="empty-action-btn" bindtap="refreshGoodsList">
          刷新看看
        </button>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{hasMore && goodsList.length > 0}}">
      <text class="load-more-text" bindtap="loadMore">点击加载更多</text>
    </view>

    <!-- 加载状态 -->
    <view class="loading-container" wx:if="{{loading}}">
      <text class="loading-text">加载中...</text>
    </view>
  </view>

  <!-- 底部安全区域 -->
  <view class="safe-bottom"></view>

  <!-- P26-P1B：兑换确认弹窗 -->
  <view wx:if="{{showExchangeModal}}" style="position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;z-index:100;">
    <view style="width:80%;background:#fff;border-radius:24rpx;padding:48rpx 40rpx;box-sizing:border-box;">
      <text style="display:block;font-size:34rpx;font-weight:600;text-align:center;margin-bottom:24rpx;">确认兑换</text>
      <text style="display:block;font-size:28rpx;color:#333;text-align:center;margin-bottom:8rpx;">{{selectedGoods.name}}</text>
      <text style="display:block;font-size:26rpx;color:#888;text-align:center;margin-bottom:32rpx;">消耗 {{selectedGoods.pointsRequired}} 积分</text>
      <button bindtap="confirmExchange" style="background:#07c160;color:#fff;border-radius:40rpx;font-size:30rpx;margin-bottom:16rpx;">确认兑换</button>
      <button bindtap="cancelExchange" style="background:#f2f2f2;color:#666;border-radius:40rpx;font-size:30rpx;">取消</button>
    </view>
  </view>

  <!-- P26-P1B：兑换成功弹窗 -->
  <view wx:if="{{showSuccessModal}}" style="position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;z-index:100;">
    <view style="width:80%;background:#fff;border-radius:24rpx;padding:48rpx 40rpx;box-sizing:border-box;text-align:center;">
      <text style="display:block;font-size:56rpx;margin-bottom:16rpx;">✅</text>
      <text style="display:block;font-size:34rpx;font-weight:600;margin-bottom:24rpx;">兑换成功</text>
      <text style="display:block;font-size:24rpx;color:#888;margin-bottom:8rpx;">领取码</text>
      <text style="display:block;font-size:40rpx;font-weight:700;letter-spacing:4rpx;color:#07c160;margin-bottom:32rpx;">{{successExchangeCodeDisplay}}</text>
      <button bindtap="copyExchangeCode" style="background:#07c160;color:#fff;border-radius:40rpx;font-size:30rpx;margin-bottom:16rpx;">复制领取码</button>
      <button bindtap="goToExchangeRecords" style="background:#e8f5ee;color:#07c160;border-radius:40rpx;font-size:30rpx;margin-bottom:16rpx;">查看兑换记录</button>
      <button bindtap="closeSuccessModal" style="background:#f2f2f2;color:#666;border-radius:40rpx;font-size:30rpx;">关闭</button>
    </view>
  </view>

  <!-- P26-P1B：网络异常重试弹窗 -->
  <view wx:if="{{showRetryModal}}" style="position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;z-index:100;">
    <view style="width:80%;background:#fff;border-radius:24rpx;padding:48rpx 40rpx;box-sizing:border-box;text-align:center;">
      <text style="display:block;font-size:56rpx;margin-bottom:16rpx;">⚠️</text>
      <text style="display:block;font-size:34rpx;font-weight:600;margin-bottom:16rpx;">网络异常</text>
      <text style="display:block;font-size:26rpx;color:#888;margin-bottom:32rpx;">兑换结果未知，是否重试本次兑换？</text>
      <button bindtap="retryExchange" style="background:#07c160;color:#fff;border-radius:40rpx;font-size:30rpx;margin-bottom:16rpx;">重试本次兑换</button>
      <button bindtap="closeRetryModal" style="background:#f2f2f2;color:#666;border-radius:40rpx;font-size:30rpx;">取消</button>
    </view>
  </view>
</view>
