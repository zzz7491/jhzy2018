<!-- pages/goods-detail/goods-detail.wxml -->
<view class="container">
  <!-- 商品图片轮播 -->
  <view class="goods-swiper-section">
    <swiper
      class="goods-swiper"
      indicator-dots="{{true}}"
      indicator-color="rgba(255,255,255,0.5)"
      indicator-active-color="#FF6B35"
      autoplay="{{false}}"
      interval="5000"
      duration="500"
      circular="{{true}}"
    >
      <swiper-item wx:for="{{goodsImages}}" wx:key="index">
        <image
          class="goods-image"
          src="{{item}}"
          mode="aspectFill"
          bindtap="previewImage"
          data-index="{{index}}"
        />
      </swiper-item>
    </swiper>

    <!-- 商品标签 -->
    <view class="goods-tags">
      <view class="goods-tag stock" wx:if="{{goodsData.inStock}}">
        可兑换
      </view>
      <view class="goods-tag sold-out" wx:if="{{!goodsData.inStock}}">
        已兑完
      </view>
    </view>
  </view>

  <!-- 商品基本信息卡片 -->
  <view class="goods-info-card">
    <!-- 商品名称和积分 -->
    <view class="goods-header">
      <text class="goods-name">{{goodsData.name}}</text>
      <view class="goods-price-section">
        <text class="price-label">所需积分</text>
        <view class="price-value">
          <text class="points-number">{{goodsData.points_cost}}</text>
          <text class="points-unit">积分</text>
        </view>
      </view>
    </view>

    <!-- 商品描述 -->
    <view class="goods-description" wx:if="{{goodsData.description}}">
      <text class="description-text">{{goodsData.description}}</text>
    </view>

    <!-- 商品详情 -->
    <view class="goods-details">
      <view class="detail-item">
        <text class="detail-label">库存状态：</text>
        <text class="detail-value available">{{goodsData.inStock ? '可兑换' : '已兑完'}}</text>
      </view>
      <view class="detail-item">
        <text class="detail-label">上架时间：</text>
        <text class="detail-value">{{goodsData.create_time}}</text>
      </view>
    </view>
  </view>

  <!-- 用户积分信息 -->
  <view class="user-points-card">
    <view class="points-header">
      <text class="points-title">我的积分</text>
      <button class="points-detail-btn" bindtap="viewPointsDetail">查看明细</button>
    </view>
    <view class="points-content">
      <view class="points-row">
        <text class="row-label">当前积分：</text>
        <text class="row-value">{{userPoints}}</text>
        <text class="row-unit">分</text>
      </view>
      <view class="points-row">
        <text class="row-label">兑换后剩余：</text>
        <text class="row-value {{userPoints < goodsData.points_cost ? 'insufficient' : ''}}">{{userPoints - goodsData.points_cost}}</text>
        <text class="row-unit">分</text>
      </view>
    </view>
    <view class="points-status" wx:if="{{userPoints < goodsData.points_cost}}">
      <text class="status-text insufficient">积分不足</text>
      <text class="status-tip">还需{{goodsData.points_cost - userPoints}}积分</text>
    </view>
  </view>

  <!-- 兑换规则 -->
  <view class="rules-card">
    <view class="rules-header">
      <view class="rules-title-section">
        <text class="rules-icon">📋</text>
        <text class="rules-title">兑换规则</text>
      </view>
    </view>
    <view class="rules-content">
      <block wx:for="{{exchangeRules}}" wx:key="index">
        <view class="rule-item">
          <text class="rule-index">{{index + 1}}.</text>
          <text class="rule-text">{{item}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-action-bar">
    <view class="action-left">
      <button class="action-btn contact" bindtap="contactService">
        <text class="btn-icon">📞</text>
        <text class="btn-text">联系客服</text>
      </button>
    </view>

    <view class="action-right">
      <button
        class="action-btn exchange {{!goodsData.inStock ? 'sold-out' : userPoints < goodsData.points_cost ? 'insufficient' : ''}}"
        bindtap="exchangeGoods"
        disabled="{{!goodsData.inStock || userPoints < goodsData.points_cost}}"
      >
        <text class="exchange-icon">🛒</text>
        <text class="exchange-text">
          {{!goodsData.inStock ? '已兑完' :
            userPoints < goodsData.points_cost ? '积分不足' : '立即兑换'}}
        </text>
      </button>
    </view>
  </view>

  <!-- 兑换确认弹窗 -->
  <view class="exchange-modal" wx:if="{{showExchangeModal}}">
    <view class="modal-mask" bindtap="closeExchangeModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">确认兑换</text>
        <text class="modal-close" bindtap="closeExchangeModal">✕</text>
      </view>

      <scroll-view class="modal-body" scroll-y>
        <view class="modal-goods-info">
          <image class="modal-goods-image" src="{{goodsImages[0] || '/images/default-goods.png'}}"></image>
          <view class="modal-goods-details">
            <text class="modal-goods-name">{{goodsData.name}}</text>
            <view class="modal-goods-price">
              <text class="modal-price-label">所需积分：</text>
              <text class="modal-price-value">{{goodsData.points_cost}}</text>
            </view>
          </view>
        </view>

        <view class="modal-points-change">
          <view class="points-change-item">
            <text class="change-label">当前积分：</text>
            <text class="change-value current">{{userPoints}}</text>
          </view>
          <view class="points-change-item">
            <text class="change-label">扣除积分：</text>
            <text class="change-value deduct">-{{goodsData.points_cost}}</text>
          </view>
          <view class="points-change-item total">
            <text class="change-label">剩余积分：</text>
            <text class="change-value remaining">{{userPoints - goodsData.points_cost}}</text>
          </view>
        </view>

        <view class="modal-notice">
          <view class="notice-header">
            <text class="notice-icon">⚠️</text>
            <text class="notice-title">重要提示</text>
          </view>
          <view class="notice-content">
            <block wx:for="{{exchangeRules}}" wx:key="index">
              <view class="notice-item">
                <text class="notice-bullet">•</text>
                <text class="notice-text">{{item}}</text>
              </view>
            </block>
          </view>
        </view>
      </scroll-view>

      <view class="modal-footer">
        <button class="modal-btn cancel" bindtap="closeExchangeModal">再想想</button>
        <button class="modal-btn confirm" bindtap="confirmExchange">确认兑换</button>
      </view>
    </view>
  </view>

  <!-- 兑换成功弹窗 -->
  <view class="success-modal" wx:if="{{showSuccessModal}}">
    <view class="modal-mask" bindtap="closeSuccessModal"></view>
    <view class="success-content">
      <view class="success-header">
        <view class="success-icon">✅</view>
        <text class="success-title">兑换成功！</text>
      </view>

      <view class="success-message">
        <text>{{successMessage}}</text>
      </view>

      <view class="success-details" wx:if="{{formattedExchangeCode}}">
        <view class="detail-item">
          <text class="detail-label">领取码：</text>
          <view class="code-section">
            <text class="code-value">{{formattedExchangeCode}}</text>
            <button class="copy-btn" bindtap="copyExchangeCode">
              <text class="copy-icon">📋</text>
              复制
            </button>
          </view>
        </view>
        <view class="detail-item">
          <text class="detail-label">兑换时间：</text>
          <text class="detail-value">{{currentTime}}</text>
        </view>
        <view class="detail-item">
          <text class="detail-label">商品名称：</text>
          <text class="detail-value">{{goodsData.name}}</text>
        </view>
      </view>

      <view class="success-actions">
        <button class="success-btn record" bindtap="viewExchangeRecords">查看兑换记录</button>
        <button class="success-btn close" bindtap="closeSuccessModal">完成</button>
      </view>
    </view>
  </view>

  <!-- 网络异常重试弹窗 -->
  <view class="retry-modal" wx:if="{{showRetryModal}}">
    <view class="modal-mask" bindtap="cancelRetry"></view>
    <view class="success-content">
      <view class="success-header">
        <view class="success-icon">⚠️</view>
        <text class="success-title">网络异常</text>
      </view>
      <view class="success-message">
        <text>{{retryMessage}}</text>
      </view>
      <view class="success-actions">
        <button class="success-btn record" bindtap="retryExchange">重试本次兑换</button>
        <button class="success-btn close" bindtap="cancelRetry">取消</button>
      </view>
    </view>
  </view>
</view>
