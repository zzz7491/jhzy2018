<view class="container">
  <!-- 状态标签 -->
  <view class="status-tabs">
    <view
      class="tab-item {{filterStatus === 'all' ? 'active' : ''}}"
      bindtap="switchStatus"
      data-status="all"
    >
      全部
    </view>
    <view
      class="tab-item {{filterStatus === '1' ? 'active' : ''}}"
      bindtap="switchStatus"
      data-status="1"
    >
      待领取
    </view>
    <view
      class="tab-item {{filterStatus === '2' ? 'active' : ''}}"
      bindtap="switchStatus"
      data-status="2"
    >
      已领取
    </view>
    <view
      class="tab-item {{filterStatus === '34' ? 'active' : ''}}"
      bindtap="switchStatus"
      data-status="34"
    >
      已结束
    </view>
  </view>

  <!-- 统计信息 -->
  <view class="stats-bar" wx:if="{{records.length > 0}}">
    <text>共 {{total}} 条记录</text>
    <text wx:if="{{pendingCount > 0}}">待领取 {{pendingCount}}</text>
    <text wx:if="{{completedCount > 0}}">已领取 {{completedCount}}</text>
  </view>

  <!-- 记录列表 -->
  <scroll-view
    scroll-y
    class="records-scroll"
    bindscrolltolower="onReachBottom"
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="records-list">
      <block wx:if="{{records.length > 0}}">
        <view
          class="record-item"
          wx:for="{{records}}"
          wx:key="order_no"
        >
          <!-- 商品信息头部 -->
          <view class="item-header" bindtap="viewGoodsDetail" data-id="{{item.product_public_id}}">
            <text class="goods-name">{{item.goods_name}}</text>
            <text class="status {{item.statusClass}}">{{item.statusText}}</text>
          </view>

          <!-- 兑换信息主体 -->
          <view class="item-body">
            <!-- 积分消耗 -->
            <view class="info-row">
              <text class="label">消耗积分：</text>
              <text class="points">{{item.points_spent}}分</text>
            </view>

            <!-- 领取码 -->
            <view class="code-section">
              <view class="code-row">
                <text class="label">领取码：</text>
                <text class="code">{{item.exchange_code}}</text>
                <text class="copy-btn" bindtap="copyCode" data-code="{{item.exchange_code_raw}}">复制</text>
              </view>
            </view>

            <!-- 兑换时间 -->
            <view class="info-row">
              <text class="label">兑换时间：</text>
              <text class="time" style="color:#333; font-weight:500;">{{item.created_at}}</text>
            </view>

            <!-- 领取时间（已核销时显示） -->
            <view wx:if="{{item.verified_at}}" class="info-row">
              <text class="label">领取时间：</text>
              <text class="time" style="color:#333; font-weight:500;">{{item.verified_at}}</text>
            </view>
          </view>

          <!-- 操作按钮 -->
          <view class="item-footer">
            <button class="contact-btn" bindtap="contactService">联系客服</button>
          </view>
        </view>
      </block>

      <!-- 空状态 -->
      <view wx:else class="empty-state">
        <image src="/images/empty-records.png" mode="aspectFit" class="empty-image"></image>
        <text class="empty-text">暂无兑换记录</text>
        <button class="go-mall-btn" bindtap="goToMall">去积分商城</button>
      </view>

      <!-- 加载更多 -->
      <view wx:if="{{loadingMore}}" class="loading-more">
        <text>加载中...</text>
      </view>

      <view wx:if="{{!hasMore && records.length > 0}}" class="no-more">
        <text>没有更多了</text>
      </view>
    </view>
  </scroll-view>

  <!-- 加载中 -->
  <view wx:if="{{loading && records.length === 0}}" class="loading-state">
    <text>加载中...</text>
  </view>
</view>
