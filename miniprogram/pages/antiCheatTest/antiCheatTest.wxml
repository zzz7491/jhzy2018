<!-- pages/antiCheatTest/antiCheatTest.wxml -->
<view class="container">
  <!-- 标题 -->
  <view class="header">
    <text class="title">防作弊系统测试</text>
    <text class="subtitle">验证防作弊功能是否正常工作</text>
  </view>

  <!-- 设备信息卡片 -->
  <view class="card" wx:if="{{deviceInfo}}">
    <view class="card-header">
      <text class="card-title">设备信息</text>
      <button class="mini-btn" size="mini" bindtap="viewDeviceDetail">详情</button>
    </view>
    <view class="card-content">
      <view class="info-item">
        <text class="info-label">设备指纹:</text>
        <text class="info-value">{{deviceInfo.device_fingerprint || '未知'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">设备型号:</text>
        <text class="info-value">{{deviceInfo.device_model || '未知'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">系统版本:</text>
        <text class="info-value">{{deviceInfo.os_version || '未知'}}</text>
      </view>
    </view>
  </view>

  <!-- 测试控制 -->
  <view class="card">
    <view class="card-header">
      <text class="card-title">测试控制</text>
    </view>
    <view class="card-content">
      <button class="primary-btn" bindtap="runAllTests" loading="{{isTesting}}" disabled="{{isTesting}}">
        {{isTesting ? '测试中...' : '运行全面测试'}}
      </button>
      
      <view class="button-group">
        <button class="secondary-btn" bindtap="testDeviceInfo" disabled="{{isTesting}}">测试设备信息</button>
        <button class="secondary-btn" bindtap="testLocation" disabled="{{isTesting}}">测试位置获取</button>
        <button class="secondary-btn" bindtap="testWarnings" disabled="{{isTesting}}">测试警告系统</button>
      </view>
    </view>
  </view>

  <!-- 测试结果 -->
  <view class="card" wx:if="{{testResults.length > 0}}">
    <view class="card-header">
      <text class="card-title">测试结果 ({{testResults.length}})</text>
      <button class="mini-btn" size="mini" bindtap="clearTestData">清除</button>
    </view>
    <view class="card-content">
      <scroll-view class="results-list" scroll-y>
        <view class="result-item" wx:for="{{testResults}}" wx:key="index">
          <view class="result-header">
            <text class="result-name">{{item.name}}</text>
            <text class="result-status {{item.status}}">{{item.status}}</text>
          </view>
          <view class="result-message">{{item.message}}</view>
          <view class="result-time">{{item.time}}</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 警告记录 -->
  <view class="card" wx:if="{{warnings.length > 0}}">
    <view class="card-header">
      <text class="card-title">警告记录 ({{warnings.length}})</text>
    </view>
    <view class="card-content">
      <view class="warning-item" wx:for="{{warnings}}" wx:key="index">
        <view class="warning-type">{{item.type}}</view>
        <view class="warning-message">{{item.message}}</view>
        <view class="warning-time">{{item.time}}</view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons">
    <button class="action-btn" bindtap="exportTestReport">导出测试报告</button>
    <button class="action-btn" bindtap="goToGuide">查看防作弊说明</button>
  </view>

  <!-- 调试信息 -->
  <view class="card" wx:if="{{debugInfo}}">
    <view class="card-header">
      <text class="card-title">调试信息</text>
      <button class="mini-btn" size="mini" bindtap="viewDebugInfo">详情</button>
    </view>
    <view class="card-content">
      <view class="debug-info">
        <text>日志数量: {{debugInfo.totalLogs || 0}}</text>
        <text>调试模式: {{debugInfo.debugMode ? '开启' : '关闭'}}</text>
      </view>
    </view>
  </view>
</view>
