/* 防作弊测试页面样式 */
.container {
  padding: 20rpx;
}

.card {
  margin: 20rpx 0;
  padding: 30rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.btn {
  margin: 20rpx 0;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.info {
  font-size: 28rpx;
  color: #666;
  margin: 10rpx 0;
}

.warning {
  color: #e64340;
  font-weight: bold;
}

.success {
  color: #07c160;
  font-weight: bold;
}

.section {
  margin: 40rpx 0 20rpx;
  border-top: 1rpx solid #eee;
  padding-top: 20rpx;
}