<view class="container">
  <view class="header">
    <text class="back-btn" bindtap="goBack">← 返回</text>
    <text class="title">{{courseTitle}}</text>
  </view>

  <!-- 团队上下文缺失 -->
  <view wx:if="{{teamMissing}}" class="min-duration-tip">
    <text class="tip-icon">👥</text>
    <text class="tip-text">请先选择团队后学习</text>
    <button class="next-btn" bindtap="goToSelectTeam">去选择团队</button>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{!teamMissing}}" class="content">
    <view class="chapter-list">
      <view
        class="chapter-item {{currentLesson.public_id == item.public_id ? 'active' : ''}} {{item.completed ? 'completed' : ''}}"
        wx:for="{{lessons}}"
        wx:key="public_id"
        bindtap="selectLesson"
        data-public-id="{{item.public_id}}"
        data-index="{{index}}"
      >
        <text class="chapter-title">{{item.order}}. {{item.title}}</text>
        <text class="chapter-status" wx:if="{{item.completed}}">✓</text>
      </view>
    </view>

    <view class="chapter-content" wx:if="{{currentLesson}}">
      <view class="content-text" wx:if="{{currentLesson.lesson_type === 'article'}}">
        <rich-text nodes="{{currentLesson.content}}"></rich-text>
      </view>
      <video wx:elif="{{currentLesson.lesson_type === 'video'}}" src="{{currentLesson.content}}" controls></video>
      <audio wx:elif="{{currentLesson.lesson_type === 'audio'}}" src="{{currentLesson.content}}" controls></audio>
      <view wx:else class="content-text">
        <rich-text nodes="{{currentLesson.content}}"></rich-text>
      </view>

      <view class="min-duration-tip {{currentLesson.completed ? 'completed-tip' : ''}}">
        <text class="tip-icon">{{currentLesson.completed ? '✅' : '⏱️'}}</text>
        <text class="tip-text">{{currentLesson.completed ? '本章节已完成' : '本章建议学习 ' + (currentLesson.duration_min || 0) + ' 分钟'}}</text>
      </view>

      <button class="next-btn" bindtap="completeAndNext">
        {{currentLessonIndex + 1 < lessons.length ? '完成本章并继续' : '完成课程'}}
      </button>
    </view>
  </view>
</view>
