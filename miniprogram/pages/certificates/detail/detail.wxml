<view class="container">
  <!-- 团队上下文缺失 -->
  <view wx:if="{{teamMissing}}" class="state-box">
    <text class="state-icon">👥</text>
    <text class="state-text">请先选择团队</text>
    <button class="primary-btn" bindtap="goToSelectTeam">去选择团队</button>
  </view>

  <view wx:elif="{{loading}}" class="state-box">
    <view class="loading"></view>
    <text class="state-text">加载中...</text>
  </view>

  <view wx:elif="{{errorMsg}}" class="state-box">
    <text class="state-icon">⚠️</text>
    <text class="state-text">{{errorMsg}}</text>
  </view>

  <scroll-view wx:elif="{{certificate}}" class="content" scroll-y>
    <view class="cert-card">
      <view class="cert-header">
        <text class="cert-name">{{certificate.cert_type === 'training' ? '培训证书' : certificate.cert_type}}</text>
        <text class="cert-status {{certificate.status === 1 ? 'valid' : 'invalid'}}">{{certificate.status === 1 ? '有效' : '已失效'}}</text>
      </view>

      <view class="cert-number">
        <text class="label">证书编号</text>
        <text class="value">{{certificate.cert_no}}</text>
      </view>

      <view class="cert-info">
        <view class="info-item" wx:if="{{certificate.holder_name}}">
          <text class="label">持证人</text>
          <text class="value">{{certificate.holder_name}}</text>
        </view>
        <view class="info-item" wx:if="{{certificate.issuer_name}}">
          <text class="label">颁发机构</text>
          <text class="value">{{certificate.issuer_name}}</text>
        </view>
        <view class="info-item" wx:if="{{certificate.issuedAtText}}">
          <text class="label">颁发时间</text>
          <text class="value">{{certificate.issuedAtText}}</text>
        </view>
        <view class="info-item" wx:if="{{certificate.course_public_id}}">
          <text class="label">关联课程</text>
          <text class="value">{{certificate.course_public_id}}</text>
        </view>
        <view class="info-item" wx:if="{{certificate.activity_public_id}}">
          <text class="label">关联活动</text>
          <text class="value">{{certificate.activity_public_id}}</text>
        </view>
      </view>

      <view class="note">本证书由嘉禾志愿服务平台颁发，可通过证书编号验真。</view>
    </view>
  </scroll-view>
</view>
