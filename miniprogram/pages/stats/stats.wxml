<view class="container">
  <!-- 年份选择器 -->
  <view class="year-selector">
    <view class="year-list">
      <view class="year-item {{selectedYear === item ? 'active' : ''}}"
            wx:for="{{yearRange}}" wx:key="index"
            data-year="{{item}}"
            bindtap="onYearChange">
        {{item}}年
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <scroll-view wx:else class="content" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 核心数据卡片 -->
    <view class="stats-grid">
      <view class="stat-card">
        <text class="stat-value">{{statsData.basicStats.totalHours}}</text>
        <text class="stat-label">服务时长(小时)</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{statsData.basicStats.totalActivities}}</text>
        <text class="stat-label">参与活动</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{statsData.basicStats.totalPoints}}</text>
        <text class="stat-label">累计积分</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{statsData.basicStats.rank}}</text>
        <text class="stat-label">排名</text>
      </view>
    </view>

    <!-- 连续服务卡片 -->
    <view class="continuous-card">
      <view class="continuous-item">
        <text class="continuous-label">加入天数</text>
        <text class="continuous-value">{{statsData.basicStats.joinDays}}天</text>
      </view>
      <view class="continuous-item">
        <text class="continuous-label">连续服务</text>
        <text class="continuous-value">{{statsData.basicStats.consecutiveDays}}天</text>
      </view>
    </view>

    <!-- 月度趋势 -->
    <view class="chart-section">
      <view class="section-title">
        <text class="title-text">{{selectedYear}}年服务趋势</text>
        <text class="title-tag">月度统计</text>
      </view>
      
      <!-- 简易柱状图（用高度模拟） -->
      <view class="bar-chart">
        <view class="chart-y-axis">
          <text>30h</text>
          <text>20h</text>
          <text>10h</text>
          <text>0h</text>
        </view>
        <view class="chart-bars">
          <view class="bar-group" wx:for="{{chartData.hours}}" wx:key="index">
            <view class="bar" style="height: {{item * 6}}rpx; background: #07c160;">
              <text class="bar-value">{{item}}</text>
            </view>
            <text class="bar-label">{{index + 1}}月</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 服务分类 -->
    <view class="category-section">
      <view class="section-title">
        <text class="title-text">服务分类</text>
        <text class="title-tag">累计时长分布</text>
      </view>
      
      <view class="category-list">
        <view class="category-item" wx:for="{{statsData.categoryStats}}" wx:key="index">
          <view class="category-header">
            <view class="category-name-wrapper">
              <view class="category-dot" style="background-color: {{item.color}}"></view>
              <text class="category-name">{{item.name}}</text>
            </view>
            <view class="category-stats">
              <text class="category-hours">{{item.hours}}小时</text>
              <text class="category-count">{{item.count}}次</text>
            </view>
          </view>
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{(item.hours / maxHours) * 100}}%; background: {{item.color}};"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 成就列表 -->
    <view class="achievement-section">
      <view class="section-title">
        <text class="title-text">成就勋章</text>
        <text class="title-tag">已获{{achievedCount}}/{{statsData.achievements.length}}</text>
      </view>
      
      <view class="achievement-grid">
        <view class="achievement-card {{!item.achieved ? 'unlocked' : ''}}"
              wx:for="{{statsData.achievements}}" wx:key="id"
              data-item="{{item}}"
              bindtap="viewAchievementDetail">
          <view class="achievement-icon {{item.achieved ? '' : 'gray'}}">
            {{item.achieved ? '🏆' : '🏅'}}
          </view>
          <text class="achievement-name">{{item.name}}</text>
          <text class="achievement-desc">{{item.desc}}</text>
          <view wx:if="{{item.achieved}}" class="achievement-date">{{item.date}}</view>
          <view wx:else class="achievement-locked">未达成</view>
        </view>
      </view>
    </view>

    <!-- 分享按钮 -->
    <view class="share-btn" bindtap="shareStats">
      <text>📊 分享我的服务报告</text>
    </view>
  </scroll-view>
    <!-- 隐藏的画布，用于生成海报 -->
  <canvas type="2d" id="posterCanvas" style="width: 300px; height: 500px; position: fixed; left: -999px; top: 0;"></canvas>
</view>