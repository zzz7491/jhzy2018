<!-- pages/index/index.wxml - JHZY 2.0 首页（P1-A.5 智能志愿型 · 最终视觉精修） -->
<view class="home safe-top {{isSeniorMode ? 'senior-mode' : ''}}">

  <!-- 1. SMART HERO（本地已认可 Hero 素材；文字承担品牌上下文，不与人物/机器人重叠） -->
  <view class="hero">
    <image class="hero-bg" src="/images/home-v2/hero-ai.webp" mode="aspectFill" lazy-load="{{true}}" />
    <view class="hero-mask"></view>
    <view class="hero-inner">
      <view class="hero-text">
        <view class="hero-brand">
          <text class="hero-platform">嘉禾志愿 · 志愿服务数字平台</text>
          <view class="hero-team" wx:if="{{teamName}}">
            <text class="hero-team-name">{{teamName}}</text>
          </view>
        </view>
        <view class="hero-greet" wx:if="{{isLoggedIn}}">
          <text>你好，{{userInfo.real_name || userInfo.name || '志愿者'}}</text>
        </view>
        <view class="hero-title">让 AI 陪你一起做公益</view>
        <view class="hero-sub">更合适的活动 · 更清晰的成长 · 更温暖的坚持</view>
      </view>
    </view>
    <!-- 大字版：保留真实适老开关功能，降为弱视觉角标 -->
    <view class="hero-mode" bindtap="toggleDisplayMode">
      <text class="hero-mode-text">{{isSeniorMode ? '标准版' : '大字版'}}</text>
    </view>
  </view>

  <!-- 0. 今日志愿服务智能状态卡（P0-B：权威 G1 状态，首页最高优先级功能卡；ranking 等不得高于此） -->
  <view class="service-card service-{{serviceState}}">

    <!-- LOADING：轻量 skeleton，绝不显示「当前没有服务」假状态 -->
    <block wx:if="{{serviceState === 'LOADING'}}">
      <view class="sv-skeleton">
        <view class="sv-skel-line sv-skel-line-1"></view>
        <view class="sv-skel-line sv-skel-line-2"></view>
      </view>
    </block>

    <!-- GUEST：不请求 G1、不强制登录，引导走现有合法登录入口 -->
    <block wx:elif="{{serviceState === 'GUEST'}}">
      <text class="sv-kicker">今日志愿服务</text>
      <text class="sv-title">开始志愿服务</text>
      <text class="sv-sub">登录后可查看服务状态并参与志愿活动</text>
      <button class="sv-btn sv-btn-primary" bindtap="onServicePrimary" hover-class="sv-btn-hover">登录 / 注册</button>
    </block>

    <!-- NO_ACTIVE：G2 未完成，不提供「立即签到」（首页无 authoritative eligible activity） -->
    <block wx:elif="{{serviceState === 'NO_ACTIVE'}}">
      <text class="sv-kicker">今日志愿服务</text>
      <text class="sv-title">今日志愿服务</text>
      <text class="sv-sub">当前没有进行中的志愿服务</text>
      <button class="sv-btn sv-btn-primary" bindtap="onServicePrimary" hover-class="sv-btn-hover">发现活动</button>
    </block>

    <!-- ACTIVE：最高优先级，明显显示「服务进行中」+ 签到时间 + 签退（唯一主动作） -->
    <block wx:elif="{{serviceState === 'ACTIVE'}}">
      <view class="sv-head">
        <view class="sv-live">
          <text class="sv-live-dot"></text>
          <text class="sv-live-text">服务进行中</text>
        </view>
      </view>
      <text class="sv-title">{{serviceActivityName ? serviceActivityName : '志愿活动服务中'}}</text>
      <view class="sv-meta" wx:if="{{serviceCheckinText}}">
        <text class="sv-meta-label">签到时间</text>
        <text class="sv-meta-value">{{serviceCheckinText}}</text>
      </view>
      <button class="sv-btn sv-btn-active" bindtap="onServicePrimary" hover-class="sv-btn-hover">签退</button>
    </block>

    <!-- ERROR：保留 UNKNOWN，不得误导为「当前没有进行中的志愿服务」 -->
    <block wx:elif="{{serviceState === 'ERROR'}}">
      <text class="sv-kicker">今日志愿服务</text>
      <text class="sv-title">服务状态暂时无法获取</text>
      <text class="sv-sub">请检查网络后重试</text>
      <button class="sv-btn sv-btn-primary" bindtap="onServicePrimary" hover-class="sv-btn-hover">重新获取</button>
    </block>
  </view>

  <!-- 2. AI 智能问答入口（输入条样式：左图形 / 中问题 / 右箭头，不新增 API / 不改后端） -->
  <view class="ai-entry" bindtap="goToAi">
    <view class="ai-mark">
      <text class="ai-mark-glyph">AI</text>
    </view>
    <view class="ai-body">
      <text class="ai-q">试试问我：这周末有什么适合我的志愿活动？</text>
      <text class="ai-hint">志愿服务智能助手</text>
    </view>
    <text class="ai-arrow">›</text>
  </view>

  <!-- 3. 为你推荐（真实 hotActivities；图片优先大图卡，无图时高质量占位，不声称已实现的推荐算法） -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">为你推荐</text>
      <text class="section-more" bindtap="goToAllActivities">查看全部</text>
    </view>
    <swiper wx:if="{{hotActivities.length > 0}}" class="rec-swiper" autoplay="{{true}}" circular="{{true}}" interval="4000" indicator-dots="{{true}}" indicator-active-color="#E15A2B">
      <swiper-item wx:for="{{hotActivities}}" wx:key="id">
        <view class="rec-card" bindtap="goToActivityDetail" data-id="{{item.id}}">
          <view class="rec-media">
            <image wx:if="{{item.coverImage}}" src="{{item.coverImage}}" mode="aspectFill" class="rec-img" />
            <view wx:else class="rec-ph">
              <view class="rec-ph-shape"></view>
            </view>
          </view>
          <view class="rec-body">
            <text class="rec-title">{{item.title}}</text>
            <view class="rec-meta">
              <text class="rec-meta-text">{{item.time}}</text>
              <text class="rec-meta-text" wx:if="{{item.location}}">{{item.location}}</text>
            </view>
            <view class="rec-foot">
              <text wx:if="{{item.points}}" class="rec-points">+{{item.points}}积分</text>
              <text class="rec-status status-{{item.status}}">{{item.statusText}}</text>
            </view>
          </view>
        </view>
      </swiper-item>
    </swiper>
    <view wx:else class="empty empty-card">
      <view class="empty-ph"></view>
      <text class="empty-text">暂无推荐活动</text>
    </view>
  </view>

  <!-- 4. 三大智能能力（统一视觉能力卡：3 等宽，图为主视觉，无设置菜单感，零 emoji） -->
  <view class="caps">
    <text class="caps-title">智能志愿服务</text>
    <view class="cap-grid">
      <view class="cap" bindtap="goToAllActivities">
        <view class="cap-card">
          <view class="cap-visual">
            <image src="/images/home-v2/smart-find.png" mode="aspectFill" class="cap-img" />
          </view>
          <view class="cap-body">
            <text class="cap-name">智能找活动</text>
            <text class="cap-desc">发现适合活动</text>
          </view>
        </view>
      </view>
      <view class="cap" bindtap="goToAi">
        <view class="cap-card">
          <view class="cap-visual">
            <image src="/images/home-v2/smart-assistant.png" mode="aspectFill" class="cap-img" />
          </view>
          <view class="cap-body">
            <text class="cap-name">志愿助手</text>
            <text class="cap-desc">随时问答</text>
          </view>
        </view>
      </view>
      <view class="cap" bindtap="goToGrowth">
        <view class="cap-card">
          <view class="cap-visual">
            <image src="/images/home-v2/growth-plan.png" mode="aspectFill" class="cap-img" />
          </view>
          <view class="cap-body">
            <text class="cap-name">成长计划</text>
            <text class="cap-desc">成长建议</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 5. 我的公益足迹（登录展示真实数据；游客轻量引导，不伪造数字、不放大 CTA） -->
  <view class="footprint">
    <text class="footprint-title">我的公益足迹</text>
    <block wx:if="{{isLoggedIn}}">
      <view class="footprint-metrics">
        <view class="fm">
          <text class="fm-value">{{stats.totalHours}}</text>
          <text class="fm-label">服务时长(时)</text>
        </view>
        <view class="fm">
          <text class="fm-value">{{stats.totalActivities}}</text>
          <text class="fm-label">参与活动</text>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="footprint-guest">
        <view class="footprint-guest-main">
          <text class="footprint-guest-title">我的公益足迹</text>
          <text class="footprint-guest-sub">登录后查看你的公益足迹</text>
        </view>
        <view class="footprint-guest-link" bindtap="goToLogin">
          <text class="footprint-guest-link-text">登录</text>
          <text class="footprint-guest-link-arrow">›</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 6. 公益故事 / 平台公益内容（有真实数据用真实；无数据展示品牌视觉，不编造故事） -->
  <view class="section section-story">
    <view class="section-head">
      <text class="section-title">公益故事</text>
      <text class="section-more" bindtap="goToCollaboration">去参与</text>
    </view>
    <scroll-view wx:if="{{approvedCasualWelfare.length > 0}}" scroll-x class="story-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="story-card" wx:for="{{approvedCasualWelfare}}" wx:key="id" wx:for-item="s" wx:for-index="idx" bindtap="viewCasualWelfareDetail" data-id="{{s.id}}">
        <view class="story-media">
          <image wx:if="{{idx === 0}}" src="/images/home-v2/story-community.png" mode="aspectFill" class="story-img" />
          <image wx:elif="{{idx === 1}}" src="/images/home-v2/story-warmth.png" mode="aspectFill" class="story-img" />
          <view wx:else class="story-ph">
            <view class="story-ph-shape"></view>
          </view>
        </view>
        <view class="story-body">
          <text class="story-title">{{s.title}}</text>
          <text class="story-desc">{{s.description}}</text>
          <text class="story-points">+{{s.points_reward}} 分</text>
        </view>
      </view>
    </scroll-view>
    <view wx:else class="story-brand">
      <image class="story-brand-img" src="/images/home-v2/story-community.png" mode="aspectFill" />
      <view class="story-brand-mask"></view>
      <view class="story-brand-text">
        <text class="story-brand-title">看见每一次温暖发生</text>
        <text class="story-brand-desc">公益故事 · 平台温暖瞬间</text>
      </view>
    </view>
  </view>

  <!-- 7. 最新动态（极轻次级内容，首页最多 3 条，来自 feed，不改后台数据） -->
  <view class="section section-soft section-feed" wx:if="{{feedList.length > 0}}">
    <text class="feed-title">最新动态</text>
    <view class="feed-list">
      <block wx:for="{{feedList}}" wx:key="id" wx:for-item="feed" wx:for-index="fi">
        <view class="feed-item" wx:if="{{fi < 3}}">
          <text class="feed-dot"></text>
          <text class="feed-text">{{feed.display_message}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 平台归属 + 监管备案（精简两层；技术支持/热线移至「关于我们」页面，零编造） -->
  <view class="footer">
    <text class="footer-text">© 2026 嘉兴市嘉禾志愿服务中心</text>
    <view class="footer-row">
      <text class="footer-icp">备案号：浙ICP备2025213173号-1X</text>
      <text class="footer-sep">·</text>
      <navigator url="/pages/about/index" class="footer-about" hover-class="footer-about-hover">关于我们</navigator>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>

<!-- 协议弹窗（保留） -->
<view class="protocol-modal" wx:if="{{showProtocolModal}}">
  <view class="protocol-modal-content">
    <view class="protocol-modal-header">
      <text class="protocol-modal-title">用户协议与隐私政策</text>
    </view>
    <view class="protocol-modal-body">
      <text class="protocol-text">感谢您使用嘉禾志愿。在您使用我们的服务前，请仔细阅读并同意以下协议：</text>
      <view class="protocol-links">
        <text class="protocol-link" bindtap="viewUserProtocol">《用户协议》</text>
        <text class="protocol-link" bindtap="viewPrivacyPolicy">《隐私政策》</text>
      </view>
    </view>
    <view class="protocol-modal-footer">
      <button class="protocol-btn reject" bindtap="rejectProtocol">拒绝</button>
      <button class="protocol-btn agree" bindtap="agreeProtocol">同意</button>
    </view>
  </view>
</view>
