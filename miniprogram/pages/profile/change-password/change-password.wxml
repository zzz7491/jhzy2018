<!-- pages/profile/change-password/change-password.wxml -->
<view class="page-container safe-top">
  
  <!-- 顶部导航 -->
  <view class="nav-header">
    <view class="nav-left" bindtap="goBack">
      <text class="nav-icon">‹</text>
      <text class="nav-title">修改密码</text>
    </view>
  </view>

  <!-- 修改密码表单 -->
  <scroll-view class="form-container" scroll-y>
    
    <!-- 安全提示 -->
    <view class="safety-tips">
      <text class="tips-icon">🔒</text>
      <text class="tips-text">为保障账户安全，请定期修改密码</text>
    </view>

    <!-- 当前密码 -->
    <view class="form-section">
      <view class="form-item">
        <text class="form-label required">当前密码</text>
        <input class="form-input {{formErrors.old_password ? 'error' : ''}}" 
               placeholder="请输入当前密码"
               placeholder-class="placeholder"
               password
               maxlength="20"
               value="{{formData.old_password}}"
               bindinput="onInputChange" data-field="old_password" />
        <view wx:if="{{formErrors.old_password}}" class="error-message">
          {{formErrors.old_password}}
        </view>
      </view>
    </view>

    <!-- 新密码 -->
    <view class="form-section">
      <view class="form-item">
        <text class="form-label required">新密码</text>
        <input class="form-input {{formErrors.new_password ? 'error' : ''}}" 
               placeholder="请输入新密码（6-20位字符）"
               placeholder-class="placeholder"
               password
               maxlength="20"
               value="{{formData.new_password}}"
               bindinput="onInputChange" data-field="new_password" />
        <view wx:if="{{formErrors.new_password}}" class="error-message">
          {{formErrors.new_password}}
        </view>
        <view class="password-rules">
          <text class="rule-item {{isValidPasswordLength ? 'valid' : ''}}">• 6-20位字符</text>
          <text class="rule-item {{isValidPasswordComplexity ? 'valid' : ''}}">• 包含字母和数字</text>
        </view>
      </view>

      <!-- 确认新密码 -->
      <view class="form-item">
        <text class="form-label required">确认新密码</text>
        <input class="form-input {{formErrors.confirm_password ? 'error' : ''}}" 
               placeholder="请再次输入新密码"
               placeholder-class="placeholder"
               password
               maxlength="20"
               value="{{formData.confirm_password}}"
               bindinput="onInputChange" data-field="confirm_password" />
        <view wx:if="{{formErrors.confirm_password}}" class="error-message">
          {{formErrors.confirm_password}}
        </view>
        <view wx:if="{{!formErrors.confirm_password && formData.confirm_password && formData.new_password !== formData.confirm_password}}" 
              class="error-message">
          两次输入的密码不一致
        </view>
      </view>
    </view>

    <!-- 密码强度指示器 -->
    <view class="password-strength" wx:if="{{formData.new_password}}">
      <text class="strength-label">密码强度：</text>
      <view class="strength-bar">
        <view class="strength-segment {{passwordStrength >= 1 ? 'active' : ''}}"></view>
        <view class="strength-segment {{passwordStrength >= 2 ? 'active' : ''}}"></view>
        <view class="strength-segment {{passwordStrength >= 3 ? 'active' : ''}}"></view>
        <view class="strength-segment {{passwordStrength >= 4 ? 'active' : ''}}"></view>
      </view>
      <text class="strength-text">
        {{passwordStrength === 1 ? '弱' : passwordStrength === 2 ? '一般' : passwordStrength === 3 ? '强' : passwordStrength === 4 ? '很强' : ''}}
      </text>
    </view>

    <!-- 忘记密码 -->
    <view class="forgot-password">
      <text class="forgot-text" bindtap="onForgotPassword">忘记当前密码？</text>
    </view>

    <!-- 操作按钮 -->
    <view class="action-section">
      <button class="btn-secondary" bindtap="onCancel" disabled="{{submitting}}">取消</button>
      <button class="btn-primary" 
              bindtap="onSubmit" 
              loading="{{submitting}}"
              disabled="{{!isFormValid}}">
        确认修改
      </button>
    </view>

    <!-- 安全建议 -->
    <view class="security-advice">
      <text class="advice-title">安全建议：</text>
      <text class="advice-item">• 不要使用过于简单的密码（如123456）</text>
      <text class="advice-item">• 建议使用字母、数字、符号组合</text>
      <text class="advice-item">• 定期更换密码，增强账户安全性</text>
      <text class="advice-item">• 不要在公共场所输入密码</text>
    </view>

  </scroll-view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-overlay">
    <view class="loading-spinner"></view>
    <text class="loading-text">处理中...</text>
  </view>

</view>