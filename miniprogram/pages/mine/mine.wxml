<!--pages/mine/mine.wxml-->
<view class="mine-container {{isSeniorMode ? 'senior-mode' : ''}}">
  <!-- 顶部背景区域 -->
  <view class="header-bg">
    <view class="gradient-overlay"></view>
  </view>

  <!-- 用户信息卡片 -->
  <view class="user-card" wx:if="{{isLoggedIn}}">
    <view class="card-content">
      <!-- 左侧头像区域 -->
      <view class="avatar-section" bindtap="uploadAvatar">
        <view class="avatar-wrapper">
          <image class="avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}"></image>
          <view class="avatar-edit">
            <text class="icon-edit">✎</text>
          </view>
        </view>
        <view class="upload-tip">点击修改头像</view>
      </view>

      <!-- 右侧用户信息 -->
      <view class="user-info-section">
        <!-- 姓名和ID -->
        <view class="user-name-row">
          <text class="user-real-name">{{userInfo.real_name || userInfo.name || '志愿者'}}</text>
          <view class="user-id-badge">
            <text class="id-label">ID:</text>
            <text class="id-value">{{userInfo.volunteer_id || userInfo.id}}</text>
          </view>
        </view>
        
        <!-- 基本信息和等级 -->
        <view class="user-meta">
          <view class="meta-item">
            <text class="icon">👑</text>
            <text class="meta-text">{{userInfo.level || '初级'}}志愿者</text>
          </view>
          <view class="meta-item">
            <text class="icon">📱</text>
            <text class="meta-text">{{userInfo.phone || '未绑定手机'}}</text>
          </view>
        </view>
        
        <view class="user-meta">
          <view class="meta-item">
            <text class="icon">📅</text>
            <text class="meta-text">{{userInfo.age || '未填写'}}岁</text>
          </view>
          <view class="meta-item">
            <text class="icon">⭐</text>
            <text class="meta-text">{{membershipDuration}}</text>
          </view>
        </view>
        
        <view class="user-meta">
          <view class="meta-item">
            <text class="icon">📊</text>
            <text class="meta-text">排名：{{userInfo.rank || '计算中...'}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 统计数据卡片 -->
    <view class="stats-grid">
      <view class="stat-box">
        <text class="stat-value">{{stats.currentPoints || 0}}</text>
        <text class="stat-label">当前积分</text>
      </view>
      <view class="stat-box">
        <text class="stat-value">{{stats.totalActivities || 0}}</text>
        <text class="stat-label">参与活动</text>
      </view>
      <view class="stat-box">
        <text class="stat-value">{{stats.totalHours || 0}}</text>
        <text class="stat-label">服务时长</text>
      </view>
      <view class="stat-box">
        <text class="stat-value">{{userInfo.consecutive_days || 0}}</text>
        <text class="stat-label">连续服务</text>
      </view>
    </view>

    <!-- 消息入口卡片 -->
    <view class="message-entry" bindtap="goToMessage">
      <view class="message-entry-left">
        <text class="message-icon">💬</text>
        <text class="message-title">我的消息</text>
      </view>
      <view class="message-entry-right">
        <text class="unread-badge" wx:if="{{unreadCount > 0}}">{{unreadCount}}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 订阅设置入口 -->
    <view class="message-entry" bindtap="goToSubscribe">
      <view class="message-entry-left">
        <text class="message-icon">🔔</text>
        <text class="message-title">消息订阅设置</text>
      </view>
      <view class="message-entry-right">
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 积分入口（导航整合：原独立「积分」tab 并入个人中心） -->
    <view class="message-entry" bindtap="goToPointsCenter">
      <view class="message-entry-left">
        <text class="message-icon">💎</text>
        <text class="message-title">我的积分</text>
      </view>
      <view class="message-entry-right">
        <text style="margin-right:12rpx;color:#FF6B35;font-weight:600;">{{stats.currentPoints || 0}} 分</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 积分兑换入口（导航整合：原独立「积分」tab 并入个人中心） -->
    <view class="message-entry" bindtap="goToPointsExchange">
      <view class="message-entry-left">
        <text class="message-icon">🎁</text>
        <text class="message-title">积分兑换</text>
      </view>
      <view class="message-entry-right">
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 身份标识 -->
    <view wx:if="{{userIdentity}}" class="identity-badge">
      <text class="identity-icon">🛡️</text>
      <text class="identity-text">{{userIdentity}}</text>
    </view>
  </view>

  <!-- 未登录状态 -->
  <view wx:if="{{!isLoggedIn}}" class="login-card">
    <view class="login-content">
      <image class="login-avatar" src="../../images/default-avatar.png"></image>
      <text class="login-title">欢迎来到嘉禾志愿</text>
      <text class="login-subtitle">登录后查看您的志愿服务记录</text>
      <button class="login-button" bindtap="goToLogin">立即登录</button>
    </view>
  </view>

  <!-- 动态功能卡片区域（完全替换原来的快捷入口） -->
  <view wx:if="{{isLoggedIn && dashboardModules && dashboardModules.length > 0}}" class="quick-actions">
    <view class="section-title">
      <text class="title-text">快捷功能</text>
      <view class="title-decoration"></view>
    </view>
    
    <view class="actions-grid">
      <view class="action-item" wx:for="{{dashboardModules}}" wx:key="id" data-url="{{item.url}}" bindtap="goToDynamicPage">
        <view class="action-icon-box">
          <text class="action-icon">{{item.icon}}</text>
          <view wx:if="{{item.badge}}" class="badge">{{item.badge}}</view>
        </view>
        <text class="action-text">{{item.title}}</text>
      </view>
    </view>
  </view>

  <!-- 位置监控状态（保留，因为可能有用） -->
  <view wx:if="{{activeAttendance}}" class="monitor-card">
    <view class="monitor-header">
      <view class="monitor-title-section">
        <text class="monitor-icon">📍</text>
        <text class="monitor-title">活动中</text>
        <view class="monitor-status-dot"></view>
      </view>
      <view class="monitor-actions">
        <text class="monitor-action-btn" bindtap="goToActivityDetail">查看</text>
      </view>
    </view>
  </view>

  <!-- 右下角浮动按钮 -->
  <view wx:if="{{isLoggedIn}}" class="float-buttons">
    <view class="float-btn help" bindtap="goToHelpCenter">
      <text class="float-icon">🆘</text>
    </view>
    <view class="float-btn feedback" bindtap="goToFeedback">
      <text class="float-icon">💬</text>
    </view>
    <view class="float-btn logout" bindtap="handleLogout">
      <text class="float-icon">🚪</text>
    </view>
  </view>
</view>