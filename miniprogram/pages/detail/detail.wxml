<!-- pages/activity/detail/detail.wxml - P1-B3 嘉禾志愿 2.0 活动详情 -->
<view class="activity-page">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="page-state state-loading">
    <view class="spinner"></view>
    <text class="state-text">加载中...</text>
  </view>

  <!-- 错误 -->
  <view wx:elif="{{errorMsg}}" class="page-state state-error">
    <view class="state-icon">
      <text>!</text>
    </view>
    <text class="state-text">{{errorMsg}}</text>
    <button class="retry-btn" bindtap="loadActivityDetail">重新加载</button>
  </view>

  <!-- 主内容 -->
  <block wx:elif="{{activity}}">
    <view class="content-wrap">
      <!-- Hero -->
      <view class="hero">
        <view class="hero-media">
          <image wx:if="{{activity.cover_image}}" src="{{activity.cover_image}}" mode="aspectFill" class="hero-cover" />
          <view wx:else class="hero-cover hero-cover-placeholder" style="background: linear-gradient(135deg, #E15A2B 0%, #F0894E 100%);">
            <text class="hero-cover-text">嘉禾志愿</text>
          </view>
          <view class="hero-overlay"></view>
        </view>
        <button open-type="share" class="hero-share" hover-class="none">
          <image src="/images/detail-v2/icon-share.svg" class="hero-share-icon" />
        </button>
        <view class="hero-content">
          <view class="hero-badges">
            <text class="jh-badge {{activityStatus.isFull ? 'jh-badge--full' : 'jh-badge--open'}}">
              {{activityStatus.isFull ? '名额已满' : '招募中'}}
            </text>
          </view>
          <view class="hero-title">{{activity.title}}</view>
          <view wx:if="{{activity.category_name || activity.category}}" class="hero-tag">
            {{activity.category_name || activity.category}}
          </view>
        </view>
      </view>

      <!-- 主办方 -->
      <view class="jh-card host-card">
        <view class="host-avatar">
          <text>嘉</text>
        </view>
        <view class="host-body">
          <text class="host-name">嘉禾志愿</text>
          <text class="host-label">提供平台服务</text>
        </view>
      </view>

      <!-- 核心信息 -->
      <view class="jh-card info-card">
        <view class="info-row">
          <view class="info-icon">
            <image src="/images/detail-v2/icon-time.svg" class="info-icon-img" />
          </view>
          <view class="info-main">
            <text class="info-label">活动时间</text>
            <text class="info-value">{{activity.display_time}}</text>
            <text wx:if="{{recurrenceInfo && recurrenceInfo.detail}}" class="info-sub">{{recurrenceInfo.detail}}</text>
          </view>
        </view>

        <view class="info-row" wx:if="{{activity.lifecycleStatusText}}">
          <view class="info-icon">
            <image src="/images/detail-v2/icon-check.svg" class="info-icon-img" />
          </view>
          <view class="info-main">
            <text class="info-label">活动状态</text>
            <text class="info-value">{{activity.lifecycleStatusText}}</text>
          </view>
        </view>

        <view class="info-row">
          <view class="info-icon">
            <image src="/images/detail-v2/icon-location.svg" class="info-icon-img" />
          </view>
          <view class="info-main">
            <text class="info-label">活动地点</text>
            <text class="info-value">{{activity.address || '待定'}}</text>
          </view>
        </view>

        <view class="info-row info-row--stats">
          <view class="info-icon">
            <image src="/images/detail-v2/icon-users.svg" class="info-icon-img" />
          </view>
          <view class="info-main info-main--shrink">
            <text class="info-label">招募人数</text>
            <text class="info-value">{{activity.max_participants || 0}}人</text>
          </view>
          <view class="info-stat">
            <text class="stat-num">{{activity.current_participants || 0}}</text>
            <text class="stat-label">已报名</text>
          </view>
          <view class="info-stat">
            <text class="stat-num {{activityStatus.remainingSlots <= 5 ? 'stat-num--hot' : ''}}">{{activityStatus.remainingSlots}}</text>
            <text class="stat-label">剩余名额</text>
          </view>
        </view>

        <view class="info-row">
          <view class="info-icon">
            <image src="/images/detail-v2/icon-points.svg" class="info-icon-img" />
          </view>
          <view class="info-main">
            <text class="info-label">公益积分</text>
            <text class="info-value">{{activity.points_reward || 0}} 积分/小时</text>
          </view>
        </view>

        <view class="info-row" wx:if="{{activity.signupDeadlineText}}">
          <view class="info-icon">
            <image src="/images/detail-v2/icon-time.svg" class="info-icon-img" />
          </view>
          <view class="info-main">
            <text class="info-label">报名截止</text>
            <text class="info-value">{{activity.signupDeadlineText}}</text>
          </view>
        </view>
      </view>

      <!-- 保险提醒 -->
      <view class="notice-card" bindtap="onBuyInsurance">
        <view class="notice-head">
          <view class="notice-icon">
            <image src="/images/detail-v2/icon-insurance.svg" class="notice-icon-img" />
          </view>
          <view class="notice-title">保险提醒</view>
        </view>
        <text class="notice-body">请于活动开始前一天（至少提前一天）完成志愿者保险购买，未购买保险无法参与活动。</text>
        <view class="notice-foot">
          <text>了解购买方式</text>
          <image src="/images/detail-v2/icon-arrow.svg" class="notice-arrow-img" />
        </view>
      </view>

      <!-- 活动介绍 -->
      <view class="jh-card description-card">
        <view class="section-title">活动介绍</view>
        <view class="description-content">{{activity.description || activity.summary || '暂无活动介绍'}}</view>
      </view>

      <!-- M4：服务记录（完成后真实展示） -->
      <view wx:if="{{attendanceCompleted && serviceRecord}}" class="jh-card success-card">
        <view class="success-head">
          <view class="success-icon">
            <image src="/images/detail-v2/icon-check.svg" class="success-icon-img" />
          </view>
          <text class="success-title">本场服务已完成</text>
        </view>
        <view class="success-row">
          <text class="success-label">活动名称</text>
          <text class="success-value">{{activity.title}}</text>
        </view>
        <view class="success-row">
          <text class="success-label">服务日期</text>
          <text class="success-value">{{serviceRecord.business_service_date || '—'}}</text>
        </view>
        <view class="success-row">
          <text class="success-label">服务状态</text>
          <text class="success-value">已完成</text>
        </view>
        <view class="success-row">
          <text class="success-label">服务时长</text>
          <text class="success-value">{{serviceRecord.minutes || 0}} 分钟</text>
        </view>
      </view>

      <!-- 底部留白 -->
      <view class="bottom-spacer"></view>
    </view>

      <!-- 底部 CTA -->
      <view class="bottom-bar">
        <button
          wx:if="{{!attendanceCompleted && (signupStatus === 1 || signupStatus === 2)}}"
          class="cancel-btn"
          bindtap="handleCancelClick"
        >取消报名</button>
        <button
          disabled="{{signupDeadlinePassed && signupStatus === 0}}"
          class="cta-btn
            {{buttonText === '立即报名' || buttonText === '立即签到' ? 'cta-btn--primary' : ''}}
            {{buttonText === '待审核' ? 'cta-btn--warning' : ''}}
            {{buttonText === '已参与' || buttonText === '报名未通过' || buttonText === '报名已截止' ? 'cta-btn--disabled' : ''}}"
          style="background-color: {{buttonBgColor}}"
          bindtap="handleMainButtonClick"
        >
          {{buttonText}}
        </button>
      </view>
  </block>

  <!-- 保险购买弹窗 -->
  <view wx:if="{{showInsuranceModal}}" class="jh-modal">
    <view class="modal-mask" catchtap="closeInsuranceModal"></view>
    <view class="modal-content modal-content--center">
      <view class="modal-header">
        <text class="modal-title">购买保险保障</text>
        <view class="modal-close" catchtap="closeInsuranceModal">
          <image src="/images/detail-v2/icon-close.svg" class="modal-close-img" />
        </view>
      </view>
      <view class="modal-body modal-body--center">
        <text class="insurance-tip">为了您的安全，请于活动开始前至少一天办理保险。</text>
        <text class="insurance-instruction">保险由「嘉禾志愿」平台合作机构提供，请通过活动招募联系人办理，切勿向个人转账。</text>
      </view>
      <view class="modal-footer modal-footer--row">
        <button class="modal-btn modal-btn--primary" bindtap="closeInsuranceModal">我知道了</button>
      </view>
    </view>
  </view>

  <!-- 报名动态表单弹窗（M3 / P20） -->
  <view wx:if="{{showFormModal}}" class="jh-modal">
    <view class="modal-mask" catchtap="closeFormModal"></view>
    <view class="modal-content modal-content--bottom">
      <view class="modal-header">
        <text class="modal-title">填写报名信息</text>
        <view class="modal-close" catchtap="closeFormModal">
          <image src="/images/detail-v2/icon-close.svg" class="modal-close-img" />
        </view>
      </view>

      <scroll-view scroll-y class="form-scroll">
        <block wx:for="{{signupForm.fields}}" wx:key="key" wx:for-item="field">
          <view class="form-field">
            <text class="form-label">{{field.label}}{{field.required ? ' *' : ''}}</text>

            <input wx:if="{{field.type === 'text' || field.type === 'phone' || field.type === 'email' || field.type === 'id_text' || field.type === 'date'}}"
              class="form-input" placeholder="{{field.placeholder || ''}}"
              value="{{formAnswers[field.key]}}"
              data-key="{{field.key}}" bindinput="onFormInput" />

            <input wx:elif="{{field.type === 'number'}}" type="digit" class="form-input"
              placeholder="{{field.placeholder || ''}}" value="{{formAnswers[field.key]}}"
              data-key="{{field.key}}" bindinput="onFormInput" />

            <textarea wx:elif="{{field.type === 'textarea'}}" class="form-textarea"
              placeholder="{{field.placeholder || ''}}" value="{{formAnswers[field.key]}}"
              data-key="{{field.key}}" bindinput="onFormInput" />

            <switch wx:elif="{{field.type === 'boolean'}}"
              checked="{{formAnswers[field.key] === true}}"
              data-key="{{field.key}}" bindchange="onFormSwitch" />

            <radio-group wx:elif="{{field.type === 'single_select'}}" bindchange="onFormRadio" data-key="{{field.key}}">
              <label wx:for="{{field.options}}" wx:key="value" wx:for-item="opt" class="form-option">
                <radio value="{{opt.value}}" checked="{{formAnswers[field.key] === opt.value}}" />{{opt.label}}
              </label>
            </radio-group>

            <checkbox-group wx:elif="{{field.type === 'multi_select'}}" bindchange="onFormMulti" data-key="{{field.key}}">
              <label wx:for="{{field.options}}" wx:key="value" wx:for-item="opt" class="form-option">
                <checkbox value="{{opt.value}}" checked="{{formAnswers[field.key] ? formAnswers[field.key][opt.value] === true : false}}" />{{opt.label}}
              </label>
            </checkbox-group>

            <text wx:else class="form-hint">不支持的字段类型：{{field.type}}</text>
            <text wx:if="{{field.help_text}}" class="form-help">{{field.help_text}}</text>
          </view>
        </block>
      </scroll-view>

      <view wx:if="{{formError}}" class="form-error">{{formError}}</view>
      <button class="form-submit" loading="{{formSubmitting}}" bindtap="submitSignupForm">提交并报名</button>
    </view>
  </view>
</view>
