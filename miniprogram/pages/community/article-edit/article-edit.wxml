<!-- pages/community/article-edit/article-edit.wxml - 发布/编辑社区文章（志愿者端，P33-P4B） -->
<view class="container safe-top">

  <!-- 需要选择团队 -->
  <view wx:if="{{needTeam}}" class="need-team">
    <text class="need-team-icon">🏢</text>
    <text class="need-team-title">请先选择志愿团队</text>
    <text class="need-team-sub">公益社区以团队为单位，请先选择你所在的志愿团队</text>
    <button class="need-team-btn" bindtap="goSelectTeam">前往团队选择</button>
  </view>

  <!-- 编辑模式加载 -->
  <view wx:elif="{{loading}}" class="loading-container">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 编辑模式加载失败 -->
  <view wx:elif="{{error}}" class="error-container">
    <text class="error-icon">⚠️</text>
    <text class="error-text">{{errMsg || '加载失败'}}</text>
    <button class="retry-btn" bindtap="retryLoad">重试</button>
  </view>

  <!-- 表单 -->
  <view wx:else class="edit-wrap">
    <view class="field">
      <text class="field-label">标题</text>
      <input
        class="field-input"
        placeholder="填写一个标题"
        value="{{title}}"
        maxlength="80"
        bindinput="onTitleInput"
      />
    </view>

    <view class="field">
      <text class="field-label">正文</text>
      <textarea
        class="field-textarea"
        placeholder="分享你的志愿服务故事、感悟或招募信息..."
        value="{{body}}"
        maxlength="5000"
        auto-height
        bindinput="onBodyInput"
      />
    </view>

    <view class="field">
      <view class="img-head">
        <text class="field-label">图片</text>
        <text class="img-count">{{images.length}}/{{maxImages}}</text>
      </view>

      <view class="img-grid">
        <view wx:for="{{images}}" wx:key="index" class="img-cell">
          <image
            class="img-thumb"
            src="{{item.localUrl}}"
            mode="aspectFill"
          />
          <view class="img-remove" bindtap="removeImage" data-index="{{index}}">
            <text class="img-remove-x">×</text>
          </view>
        </view>

        <view wx:if="{{images.length < maxImages}}" class="img-cell img-add" bindtap="chooseImage">
          <text class="img-add-plus">＋</text>
          <text class="img-add-text">添加图片</text>
        </view>
      </view>
      <text class="img-tip">最多 {{maxImages}} 张，支持 JPG / PNG / WebP</text>
    </view>

    <button class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="submit">
      {{submitting ? '提交中...' : (mode === 'edit' ? '保存' : '提交')}}
    </button>
    <text class="submit-note">提交后将进入审核，审核通过后方可对外展示</text>
  </view>

  <view class="safe-bottom"></view>
</view>
