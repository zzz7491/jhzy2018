<!-- pages/sign/sign.wxml —— 全局考勤中心（GLOBAL ATTENDANCE HUB / TABBAR CENTER）
     G1：状态真值来自 GET /api/v2/attendance-sessions/me。
       LOADING   —— 拉取权威状态中
       GUEST     —— 无有效登录态：中性「签到 / 签退」，不触发登录
       NO_ACTIVE —— 权威返回 active=false：「当前没有进行中的志愿服务」
       ACTIVE    —— 权威返回 active=true：最高优先级，primary action 恒为「签退」
       ERROR     —— 状态未知：保持中性，提供「刷新状态」，绝不谎称没有服务
     ACTIVE 下不呈现任何「立即签到 / 另一活动签到 / 选择其他活动签到」入口。
     具体活动的签到执行在 NON-TAB 页 pages/sign/activity/index。 -->
<view class="hub safe-top">

  <!-- LOADING -->
  <view class="hub-card" wx:if="{{hubState === 'LOADING'}}">
    <text class="hub-title">签到 / 签退</text>
    <text class="hub-desc">正在获取服务状态…</text>
  </view>

  <!-- ACTIVE：最高优先级状态，primary action = 签退 -->
  <view class="hub-card hub-card--active" wx:elif="{{hubState === 'ACTIVE'}}">
    <text class="hub-badge">服务进行中</text>
    <text class="hub-title">当前志愿服务进行中</text>
    <text class="hub-desc" wx:if="{{activityTitle}}">{{activityTitle}}</text>
    <view class="hub-meta" wx:if="{{checkinAtText}}">
      <text class="hub-meta-label">签到时间</text>
      <text class="hub-meta-value">{{checkinAtText}}</text>
    </view>
  </view>

  <!-- GUEST：中性，不触发登录 -->
  <view class="hub-card" wx:elif="{{hubState === 'GUEST'}}">
    <text class="hub-title">签到 / 签退</text>
    <text class="hub-desc">登录后可查看你当前的服务状态</text>
  </view>

  <!-- NO_ACTIVE：权威 active=false -->
  <view class="hub-card" wx:elif="{{hubState === 'NO_ACTIVE'}}">
    <text class="hub-title">签到 / 签退</text>
    <text class="hub-desc">当前没有进行中的志愿服务</text>
  </view>

  <!-- ERROR：状态未知，保持中性 + 提供刷新 -->
  <view class="hub-card" wx:else>
    <text class="hub-title">签到 / 签退</text>
    <text class="hub-desc">服务状态获取失败，请稍后重试</text>
  </view>

  <!-- ACTIVE：唯一主动作 = 签退 -->
  <button
    wx:if="{{hubState === 'ACTIVE'}}"
    class="hub-action"
    bindtap="goToCheckout"
    hover-class="hub-action--hover"
  >签退</button>

  <!-- ERROR：刷新状态 -->
  <button
    wx:elif="{{hubState === 'ERROR'}}"
    class="hub-action"
    bindtap="onRefreshTap"
    hover-class="hub-action--hover"
  >刷新状态</button>

  <!-- 其余中性态：查看活动（activities 为 tab，switchTab） -->
  <button
    wx:elif="{{hubState !== 'LOADING'}}"
    class="hub-action"
    bindtap="goToActivities"
    hover-class="hub-action--hover"
  >查看活动</button>

  <view class="hub-note">
    <text class="hub-note-text" wx:if="{{hubState === 'ACTIVE'}}">请在服务结束后及时签退，服务时长与积分以签退时间为准。</text>
    <text class="hub-note-text" wx:elif="{{hubState === 'ERROR'}}">状态未知时不会显示为「没有进行中的服务」，可点击上方刷新重试。</text>
    <text class="hub-note-text" wx:elif="{{hubState === 'GUEST'}}">进入活动详情页后，使用页面内的「立即签到」完成签到 / 签退。</text>
    <text class="hub-note-text" wx:else>进入活动详情页后，使用页面内的「立即签到」完成签到 / 签退。</text>
  </view>
</view>
