<!-- pages/activities/timer/timer.wxml -->
<view class="timer-page">
  <!-- 头部 -->
  <view class="header">
    <view class="back-btn" bindtap="navigateBack">
      <text class="back-icon">‹</text>
      <text class="back-text">返回</text>
    </view>
    <text class="title">志愿服务计时</text>
    <view class="placeholder"></view>
  </view>
  
  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{isLoading}}">
    <view class="loading-content">
      <text class="loading-text">正在加载计时信息...</text>
      <view class="loading-spinner"></view>
    </view>
  </view>
  
  <!-- 错误状态 -->
  <view class="error-container" wx:if="{{!isLoading && errorMessage}}">
    <view class="error-content">
      <text class="error-icon">⚠️</text>
      <text class="error-text">{{errorMessage}}</text>
      <button class="reload-btn" bindtap="reload">重新加载</button>
    </view>
  </view>
  
  <!-- 主要内容 -->
  <view class="main-content" wx:if="{{!isLoading && !errorMessage}}">
    <!-- 活动信息 -->
    <view class="activity-info">
      <text class="activity-title">{{activityTitle || '志愿服务'}}</text>
      <view class="activity-id" bindtap="copyActivityId">
        <text>活动ID: {{activityId}}</text>
        <text class="copy-hint">点击复制</text>
      </view>
    </view>
    
    <!-- 计时器显示 -->
    <view class="timer-display-container">
      <view class="timer-display">
        <text class="timer-text">{{displayText}}</text>
      </view>
      <view class="timer-status">
        <text class="status-text" wx:if="{{isActive}}">⏱ 计时中</text>
        <text class="status-text" wx:else>⏸ 已暂停</text>
      </view>
    </view>
    
    <!-- 服务时长信息 -->
    <view class="duration-info">
      <view class="duration-item">
        <text class="duration-label">服务时长</text>
        <text class="duration-value">{{serviceDisplay}}</text>
      </view>
      
      <!-- 最低时长进度 -->
      <view class="minimum-duration" wx:if="{{!minimumReached}}">
        <view class="progress-info">
          <text class="progress-label">还需{{minutesLeft}}分钟达到30分钟</text>
          <text class="progress-percent">{{progressPercent.toFixed(0)}}%</text>
        </view>
        <progress 
          percent="{{progressPercent}}" 
          stroke-width="8" 
          activeColor="#07c160"
          backgroundColor="#ebedf0"
          show-info="{{false}}"
        />
      </view>
      
      <view class="minimum-reached" wx:else>
        <text class="reached-icon">✓</text>
        <text class="reached-text">已达到最低服务时长要求</text>
      </view>
    </view>
    
    <!-- 状态提示 -->
    <view class="status-tips">
      <view class="tip-item">
        <text class="tip-icon">📍</text>
        <text class="tip-text">请保持在服务区域内</text>
      </view>
      <view class="tip-item">
        <text class="tip-icon">⚠️</text>
        <text class="tip-text">离开区域3次将被强制签退</text>
      </view>
      <view class="tip-item">
        <text class="tip-icon">⏱</text>
        <text class="tip-text">每30秒自动同步时间</text>
      </view>
    </view>
    
    <!-- 操作按钮 -->
    <view class="action-buttons">
      <button 
        class="checkout-btn" 
        type="warn" 
        bindtap="checkoutNow"
        disabled="{{!isActive}}"
      >
        立即签退
      </button>
      
      <view class="action-tips">
        <text class="action-tip">签退后将停止计时并计算积分</text>
        <text class="action-tip">签退后无法重新签到</text>
      </view>
    </view>
    
    <!-- 调试信息（开发环境显示） -->
    <view class="debug-info" wx:if="{{false}}">
      <text>总秒数: {{totalSeconds}}</text>
      <text>同步间隔: {{syncInterval/1000}}秒</text>
      <text>活动ID: {{activityId}}</text>
      <text>签到ID: {{signinId}}</text>
    </view>
  </view>
</view>