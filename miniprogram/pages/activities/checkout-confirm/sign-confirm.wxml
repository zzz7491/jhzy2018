<!--pages/activities/checkout-confirm/sign-confirm.wxml-->
<view class="sign-confirm-page">
  <!-- 加载状态 -->
  <view wx:if="{{isLoading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>

  <!-- 主要内容 -->
  <view wx:else class="content-container">
    
    <!-- 活动标题 -->
    <view class="activity-header">
      <text class="activity-title">{{activity ? activity.title : '志愿服务'}}</text>
    </view>

    <!-- 🟢 醒目操作按钮区域 - 放在活动标题下方 -->
    <view class="quick-action-card">
      <view class="quick-action-status">
        <text class="quick-icon">{{pageType === 'signin' ? '📍' : '✅'}}</text>
        <text class="quick-title">{{pageType === 'signin' ? '签到确认' : '签退确认'}}</text>
      </view>
      <button 
        class="quick-action-btn {{pageType === 'signin' ? 'signin' : 'signout'}} {{!canProceed || isSubmitting ? 'disabled' : ''}}"
        bindtap="{{pageType === 'signin' ? 'confirmSignin' : 'confirmSignout'}}"
        disabled="{{!canProceed || isSubmitting}}"
      >
        <text wx:if="{{!isSubmitting}}">{{pageType === 'signin' ? '📍 立即签到' : '✅ 立即签退'}}</text>
        <text wx:else>{{pageType === 'signin' ? '签到中...' : '签退中...'}}</text>
      </button>
      <view wx:if="{{pageType === 'signin' && locationStatus !== 'success'}}" class="quick-tip">
        <text>⚠️ 请移动到活动范围内后再签到</text>
      </view>
      <view wx:if="{{pageType === 'signout'}}" class="quick-tip">
        <text>⚠️ 签退后无法撤销，请确认已完成服务</text>
      </view>
    </view>

    <!-- 位置验证卡片 -->
    <view class="location-card">
      <view class="location-header">
        <view class="location-title-section">
          <text class="location-icon">📍</text>
          <text class="location-title">位置验证</text>
        </view>
        <button class="refresh-location-btn" bindtap="refreshLocation" size="mini" plain>
          <text class="refresh-icon">🔄</text>
          <text>刷新</text>
        </button>
      </view>
      
      <view class="location-status {{locationStatus}}">
        <text class="status-icon">
          {{locationStatus === 'checking' ? '⏳' : 
            locationStatus === 'success' ? '✅' : '❌'}}
        </text>
        <text class="status-text">
          {{locationStatus === 'checking' ? '正在验证位置...' : 
            locationStatus === 'success' ? '位置验证通过' : '不在活动范围内'}}
        </text>
      </view>
      
      <view wx:if="{{locationStatus !== 'checking'}}" class="location-details">
        <view class="detail-item">
          <text class="detail-label">当前位置距离：</text>
          <text class="detail-value {{isWithinRange ? 'success' : 'error'}}">
            {{distance}}米
          </text>
        </view>
        <view class="detail-item">
          <text class="detail-label">签到范围：</text>
          <text class="detail-value">
            {{activity && activity.location_radius ? activity.location_radius : 500}}米
          </text>
        </view>
        <view class="detail-note">
          <text>{{pageType === 'signin' ? '签到' : '签退'}}需要在活动地点范围内完成</text>
        </view>
      </view>
    </view>

    <!-- 活动信息卡片 -->
    <view class="info-card" wx:if="{{activity}}">
      <view class="info-header">
        <text class="info-icon">📋</text>
        <text class="info-title">活动信息</text>
      </view>
      
      <view class="info-details">
        <view class="info-item">
          <text class="info-label">活动时间：</text>
          <text class="info-value">{{activity.activity_time || '待定'}}</text>
        </view>
        
        <view class="info-item">
          <text class="info-label">活动地点：</text>
          <text class="info-value">{{activity.location || '待定'}}</text>
        </view>
        
        <view wx:if="{{activity.points}}" class="info-item">
          <text class="info-label">可获得积分：</text>
          <text class="info-value">{{activity.points}}分</text>
        </view>
      </view>
    </view>

    <!-- 服务时长卡片（仅签退页面显示） -->
    <view wx:if="{{pageType === 'signout' && checkinTime}}" class="duration-card">
      <view class="duration-header">
        <text class="duration-icon">⏱️</text>
        <text class="duration-title">服务时长</text>
      </view>
      
      <view class="duration-content">
        <view class="duration-display">
          <text class="duration-value">{{formatDuration(duration)}}</text>
          <text class="duration-minutes">(约{{Math.ceil(duration / 60)}}分钟)</text>
        </view>
        
        <view class="duration-progress">
          <progress 
            percent="{{duration >= 1800 ? 100 : Math.floor((duration / 1800) * 100)}}" 
            stroke-width="12" 
            active-color="{{duration >= 1800 ? '#07c160' : '#fa8c16'}}"
            backgroundColor="#f0f0f0"
            active
          />
          <text class="progress-text">
            {{getProgressText()}}
          </text>
        </view>
      </view>
    </view>

    <!-- 积分说明卡片（仅签退页面显示） -->
    <view wx:if="{{pageType === 'signout'}}" class="points-card">
      <view class="points-header">
        <text class="points-icon">🎯</text>
        <text class="points-title">积分说明</text>
      </view>
      
      <view class="points-content">
        <view class="points-rule">
          <text class="rule-icon">📝</text>
          <text class="rule-text">服务时长≥30分钟可获得积分</text>
        </view>
        
        <view class="points-rule">
          <text class="rule-icon">⏰</text>
          <text class="rule-text">积分按实际服务时长计算</text>
        </view>
        
        <view class="points-rule">
          <text class="rule-icon">✅</text>
          <text class="rule-text">签退成功后积分自动到账</text>
        </view>
        
        <view class="current-duration" wx:if="{{duration > 0}}">
          <text class="duration-label">当前服务：</text>
          <text class="duration-time">{{formatDuration(duration)}}</text>
          <text class="duration-status {{duration >= 1800 ? 'qualified' : 'unqualified'}}">
            {{duration >= 1800 ? '（可获积分）' : '（时长不足）'}}
          </text>
        </view>
      </view>
    </view>

    <!-- 签到时间卡片（仅签到页面显示） -->
    <view wx:if="{{pageType === 'signin'}}" class="time-card">
      <view class="time-header">
        <text class="time-icon">⏰</text>
        <text class="time-title">签到时间</text>
      </view>
      
      <view class="time-content">
        <text class="current-time">{{currentTime}}</text>
        <text class="time-note">请在活动开始前30分钟内签到</text>
      </view>
    </view>

    <!-- 重要提醒 -->
    <view class="important-notices">
      <view class="notices-header">
        <text class="notices-icon">📌</text>
        <text class="notices-title">重要提醒</text>
      </view>
      
      <view class="notice-list">
        <view class="notice-item">
          <text class="notice-number">1.</text>
          <text class="notice-text">{{pageType === 'signin' ? '请确认当前位置符合要求' : '请确认已完成志愿服务'}}</text>
        </view>
        
        <view class="notice-item">
          <text class="notice-number">2.</text>
          <text class="notice-text">{{pageType === 'signin' ? '签到后请按时完成志愿服务' : '签退后请等待系统确认'}}</text>
        </view>
        
        <view class="notice-item" wx:if="{{pageType === 'signout'}}">
          <text class="notice-number">3.</text>
          <text class="notice-text">服务时长不足30分钟不计积分</text>
        </view>
        
        <view class="notice-item">
          <text class="notice-number">{{pageType === 'signin' ? '3' : '4'}}.</text>
          <text class="notice-text">操作成功后请勿重复提交</text>
        </view>
      </view>
    </view>

    <!-- 取消按钮 -->
    <view class="cancel-action">
      <button 
        class="cancel-btn"
        bindtap="cancel"
        hover-class="btn-hover"
        disabled="{{isSubmitting}}"
        plain
      >
        <text>取消</text>
      </button>
    </view>
  </view>

  <!-- 底部安全提示 -->
  <view class="safety-notice">
    <text class="safety-icon">🔒</text>
    <text class="safety-text">嘉禾志愿服务平台 - 诚信签到签退系统</text>
  </view>
</view>