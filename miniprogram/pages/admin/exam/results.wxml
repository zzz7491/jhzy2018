<view class="page">
  <view class="header">
    <text class="title">考试结果</text>
  </view>

  <view class="list" wx:if="{{sessions.length > 0}}">
    <view class="card" wx:for="{{sessions}}" wx:key="session_public_id">
      <view class="card-main">
        <text class="card-title">{{item.user_nickname || '志愿者'}}</text>
        <text class="card-sub">{{item.paper_title || '试卷'}} · 第 {{item.attempt_no}} 次</text>
      </view>
      <view class="card-meta">
        <text class="score {{item.passed === 1 ? 'pass' : 'fail'}}">
          {{item.score != null ? (item.score + ' 分') : '未提交'}}
        </text>
        <text class="badge {{item.passed === 1 ? 'on' : (item.passed === 0 ? 'off' : '')}}">
          {{item.passed === 1 ? '合格' : (item.passed === 0 ? '不合格' : '进行中')}}
        </text>
      </view>
    </view>
  </view>

  <view class="empty" wx:elif="{{!loading}}"><text>暂无考试记录</text></view>
  <view class="loading" wx:if="{{loading}}"><text>加载中…</text></view>
  <view class="nomore" wx:if="{{!hasMore && sessions.length > 0}}"><text>没有更多了</text></view>
</view>
