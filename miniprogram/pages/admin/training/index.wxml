<view class="page">
  <view class="header">
    <text class="title">培训课程</text>
    <button class="add-btn" bindtap="onAddCourse">+ 新建课程</button>
  </view>

  <view class="list" wx:if="{{courses.length > 0}}">
    <view class="card" wx:for="{{courses}}" wx:key="public_id" bindtap="onTapCourse" data-id="{{item.public_id}}">
      <view class="card-main">
        <text class="card-title">{{item.title}}</text>
        <text class="card-sub">{{item.summary || '暂无简介'}}</text>
      </view>
      <view class="card-meta">
        <text class="badge {{item.status === 1 ? 'on' : 'off'}}">{{item.status === 1 ? '已发布' : '草稿'}}</text>
        <text class="muted">章节 {{item.lesson_count}}</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:elif="{{!loading}}">
    <text>暂无课程</text>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中…</text>
  </view>
  <view class="nomore" wx:if="{{!hasMore && courses.length > 0}}">
    <text>没有更多了</text>
  </view>
</view>
