<!-- pages/admin/change-password/change-password.wxml -->
<view class="change-password-page">
  <!-- 页面头部 -->
  <view class="page-header">
    <text class="header-title">修改密码</text>
    <text class="header-subtitle">定期修改密码保障账户安全</text>
  </view>

  <!-- 当前账户信息 -->
  <view class="account-info">
    <view class="info-item">
      <text class="info-label">当前账户</text>
      <text class="info-value">{{adminName}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">账户角色</text>
      <text class="info-value">{{adminRole === 'super_admin' ? '超级管理员' : '管理员'}}</text>
    </view>
  </view>

  <!-- 密码修改表单 -->
  <view class="form-container">
    <!-- 当前密码 -->
    <view class="form-item">
      <text class="form-label required">当前密码</text>
      <view class="password-input">
        <input 
          class="form-input" 
          type="{{showCurrentPassword ? 'text' : 'password'}}"
          placeholder="请输入当前密码" 
          placeholder-class="placeholder"
          maxlength="32"
          value="{{form.current_password}}"
          data-field="current_password"
          bindinput="handleInput"
        />
        <view 
          class="toggle-eye" 
          bindtap="toggleCurrentPassword"
        >
          <text class="eye-icon">{{showCurrentPassword ? '👁️' : '👁️‍🗨️'}}</text>
        </view>
      </view>
    </view>

    <!-- 新密码 -->
    <view class="form-item">
      <text class="form-label required">新密码</text>
      <view class="password-input">
        <input 
          class="form-input" 
          type="{{showNewPassword ? 'text' : 'password'}}"
          placeholder="请输入新密码（8-32位字符）" 
          placeholder-class="placeholder"
          maxlength="32"
          value="{{form.new_password}}"
          data-field="new_password"
          bindinput="handleInput"
        />
        <view 
          class="toggle-eye" 
          bindtap="toggleNewPassword"
        >
          <text class="eye-icon">{{showNewPassword ? '👁️' : '👁️‍🗨️'}}</text>
        </view>
      </view>
      <view class="password-hint">
        <text class="hint-text">密码要求：8-32位，包含字母和数字</text>
      </view>
    </view>

    <!-- 确认新密码 -->
    <view class="form-item">
      <text class="form-label required">确认新密码</text>
      <view class="password-input">
        <input 
          class="form-input" 
          type="{{showConfirmPassword ? 'text' : 'password'}}"
          placeholder="请再次输入新密码" 
          placeholder-class="placeholder"
          maxlength="32"
          value="{{form.confirm_password}}"
          data-field="confirm_password"
          bindinput="handleInput"
        />
        <view 
          class="toggle-eye" 
          bindtap="toggleConfirmPassword"
        >
          <text class="eye-icon">{{showConfirmPassword ? '👁️' : '👁️‍🗨️'}}</text>
        </view>
      </view>
    </view>

    <!-- 密码强度指示器 -->
    <view class="form-item" wx:if="{{form.new_password}}">
      <text class="form-label">密码强度</text>
      <view class="strength-indicator">
        <view class="strength-bar {{passwordStrength >= 1 ? 'weak' + (passwordStrength === 1 ? ' active' : '') : ''}}"></view>
        <view class="strength-bar {{passwordStrength >= 2 ? 'medium' + (passwordStrength === 2 ? ' active' : '') : ''}}"></view>
        <view class="strength-bar {{passwordStrength >= 3 ? 'strong' + (passwordStrength === 3 ? ' active' : '') : ''}}"></view>
        <text class="strength-text">{{getStrengthText(passwordStrength)}}</text>
      </view>
    </view>

    <!-- 密码要求提示 -->
    <view class="requirements-section">
      <text class="requirements-title">🔒 密码安全要求</text>
      <view class="requirements-list">
        <view class="requirement-item {{passwordChecks.length ? 'checked' : ''}}">
          <text class="requirement-icon">✓</text>
          <text class="requirement-text">长度8-32个字符</text>
        </view>
        <view class="requirement-item {{passwordChecks.letter ? 'checked' : ''}}">
          <text class="requirement-icon">✓</text>
          <text class="requirement-text">至少包含一个字母</text>
        </view>
        <view class="requirement-item {{passwordChecks.number ? 'checked' : ''}}">
          <text class="requirement-icon">✓</text>
          <text class="requirement-text">至少包含一个数字</text>
        </view>
        <view class="requirement-item {{passwordChecks.match ? 'checked' : ''}}">
          <text class="requirement-icon">✓</text>
          <text class="requirement-text">两次输入密码一致</text>
        </view>
      </view>
    </view>

    <!-- 安全提示 -->
    <view class="security-notice">
      <text class="notice-title">💡 安全提示</text>
      <text class="notice-item">1. 定期更换密码可提高账户安全性</text>
      <text class="notice-item">2. 建议使用数字、字母组合的复杂密码</text>
      <text class="notice-item">3. 不要使用过于简单的密码（如123456）</text>
      <text class="notice-item">4. 修改密码后需要重新登录</text>
    </view>
  </view>

  <!-- 底部操作按钮 -->
  <view class="action-buttons">
    <button 
      class="btn cancel" 
      bindtap="cancelChange"
      hover-class="btn-hover"
    >
      取消
    </button>
    
    <button 
      class="btn submit" 
      bindtap="changePassword"
      hover-class="btn-hover"
      loading="{{submitLoading}}"
      disabled="{{submitLoading || !isFormValid}}"
    >
      {{submitLoading ? '修改中...' : '确认修改'}}
    </button>
  </view>
</view>