<view class="container">
  <!-- 核销区 -->
  <view class="verify-section">
    <input
      class="verify-input"
      placeholder="输入领取码"
      value="{{verifyCode}}"
      bindinput="onVerifyInput"
    />
    <button class="verify-btn" bindtap="doVerify">核销</button>
  </view>
  <view class="verify-result {{verifyResultType}}" wx:if="{{verifyResult}}">
    <text>{{verifyResult}}</text>
  </view>

  <!-- 状态筛选 -->
  <view class="filter-bar">
    <view class="filter-item {{currentStatus === '1' ? 'active' : ''}}" bindtap="filterStatus" data-status="1">待领取</view>
    <view class="filter-item {{currentStatus === '2' ? 'active' : ''}}" bindtap="filterStatus" data-status="2">已领取</view>
  </view>

  <!-- 记录列表 -->
  <view class="record-list" wx:if="{{records.length > 0}}">
    <view class="record-card" wx:for="{{records}}" wx:key="order_no">
      <view class="card-header">
        <text class="goods-name">{{item.goods_name}}</text>
        <text class="status status-{{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <view class="card-body">
        <view class="info-row">
          <text class="label">志愿者：</text>
          <text>{{item.user_public_id}}</text>
        </view>
        <view class="info-row">
          <text class="label">领取码：</text>
          <text class="code">{{item.exchange_code}}</text>
        </view>
        <view class="info-row">
          <text class="label">消耗积分：</text>
          <text class="points">{{item.points_spent}}</text>
        </view>
        <view class="info-row">
          <text class="label">兑换时间：</text>
          <text>{{item.created_at}}</text>
        </view>
        <view class="info-row" wx:if="{{item.verified_at}}">
          <text class="label">核销时间：</text>
          <text>{{item.verified_at}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{records.length === 0 && !loading}}">
    <text>暂无兑换记录</text>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore}}">
    <text bindtap="loadMore">{{loading ? '加载中...' : '加载更多'}}</text>
  </view>
</view>
