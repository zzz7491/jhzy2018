<view class="container">
  <view class="stats">
    <text>共 {{total}} 张培训证书</text>
  </view>

  <view class="list" wx:if="{{!loading && list.length > 0}}">
    <view class="card" wx:for="{{list}}" wx:key="public_id">
      <view class="card-header">
        <text class="name">{{item.holder_nickname || item.holder_name || '志愿者'}}</text>
        <text class="status {{item.status === 1 ? 'valid' : 'invalid'}}">{{item.status === 1 ? '有效' : '已作废'}}</text>
      </view>
      <view class="card-body">
        <view class="info-row">
          <text class="label">证书编号</text>
          <text class="value cert-code">{{item.cert_no}}</text>
        </view>
        <view class="info-row" wx:if="{{item.course_public_id}}">
          <text class="label">关联课程</text>
          <text class="value">已关联（{{item.course_public_id}}）</text>
        </view>
        <view class="info-row" wx:if="{{item.score != null}}">
          <text class="label">成绩</text>
          <text class="value">{{item.score}} 分</text>
        </view>
        <view class="info-row">
          <text class="label">发证时间</text>
          <text class="value">{{item.issued_at_text}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="empty" wx:if="{{!loading && list.length === 0}}">
    <text>暂无证书</text>
  </view>

  <view class="load-more" wx:if="{{hasMore && !loading}}">
    <text class="load-more-hint">上拉加载更多</text>
  </view>
</view>
