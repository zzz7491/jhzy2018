<view class="container">
  <view class="header">
    <view class="header-left">
      <view class="back-btn" bindtap="goBack">
        <text class="back-icon">←</text>
      </view>
      <text class="title">报名列表</text>
    </view>
    <view class="header-right">
      <view class="refresh-btn" bindtap="refresh">
        <text class="refresh-icon">⟳</text>
      </view>
    </view>
  </view>

  <view class="activity-card" wx:if="{{activity}}">
    <text class="activity-title">{{activity.title}}</text>
  </view>

  <view class="loading" wx:if="{{loadingSignups}}">
    <text>加载报名列表...</text>
  </view>

  <view class="signup-list" wx:else>
    <view class="list-header">
      <text class="list-title">志愿者名单 ({{signups.length}}人)</text>
    </view>

    <view class="empty" wx:if="{{signups.length === 0}}">
      <text>暂无志愿者报名</text>
    </view>

    <block wx:for="{{signups}}" wx:key="user_public_id">
      <view class="signup-item">
        <view class="signup-header">
          <view class="vol-name-box">
            <text class="vol-name">{{item.user_public_id}}</text>
          </view>
          <view class="status-badge {{getStatusClass(item.signup_status)}}">
            {{getStatusText(item.signup_status)}}
          </view>
        </view>

        <view class="signup-detail">
          <view class="detail-row">
            <text class="detail-label">志愿者编号：</text>
            <text class="detail-value" bindtap="copyText" data-text="{{item.user_public_id}}">{{item.user_public_id || '-'}}</text>
          </view>
          <view class="detail-row">
            <text class="detail-label">审核状态：</text>
            <text class="detail-value">{{getReviewStatusText(item.review_status)}}</text>
          </view>
          <view class="detail-row">
            <text class="detail-label">报名时间：</text>
            <text class="detail-value">{{formatTime(item.created_at)}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="footer-tip" wx:if="{{signups.length > 0}}">
    <text class="tip-text">— 共 {{signups.length}} 人报名 —</text>
  </view>
</view>