/* pages/admin/analytics.wxss —— 由 analytics.scss 编译（P37-C2）。标准 CSS，与 .scss 一致。 */
.container {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  background: #f5f7ff;
  box-sizing: border-box;
}

.header {
  padding: 16rpx 8rpx 24rpx;
}

.title-row {
  display: flex;
  align-items: center;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2330;
}

.scope-badge {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: #667eea;
  border-radius: 24rpx;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a90a2;
}

.period {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #b0b6c6;
}

.segment {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin: 16rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(102, 118, 234, 0.06);
}

.segment-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #5a6072;
  border-radius: 12rpx;
}

.segment-tab.active {
  color: #ffffff;
  background: #667eea;
  font-weight: 600;
}

.group {
  margin-top: 24rpx;
}

.group-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2330;
  margin-bottom: 12rpx;
  padding-left: 8rpx;
}

.metric-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.metric-card {
  width: calc((100% - 32rpx) / 3);
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(102, 118, 234, 0.06);
}

.metric-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff6b35;
}

.metric-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5a6072;
}

.metric-hint {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #b0b6c6;
}

.loading,
.error,
.empty {
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #8a90a2;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2330;
}

.empty-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a90a2;
}

.error-text {
  font-size: 26rpx;
  color: #e54d42;
  margin-bottom: 16rpx;
}

.primary-btn {
  margin-top: 24rpx;
  background: #667eea;
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 12rpx;
  padding: 12rpx 48rpx;
}

.ghost-btn {
  margin-top: 16rpx;
  background: #ffffff;
  color: #667eea;
  font-size: 26rpx;
  border: 1rpx solid #667eea;
  border-radius: 12rpx;
  padding: 12rpx 48rpx;
}

.footer-note {
  margin-top: 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b0b6c6;
}
