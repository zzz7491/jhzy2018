<view class="container">

  <scroll-view scroll-y class="form-scroll">
    <view class="form-section">

      <view class="section-title">基础信息</view>
      <view class="form-item required">
        <text class="label">活动标题</text>
        <input class="input" placeholder="请输入活动标题" value="{{formData.title}}" data-field="title" bindinput="onInput"/>
      </view>

      <view class="form-item">
        <text class="label">活动详情描述</text>
        <textarea class="textarea" placeholder="请输入活动详细内容、要求等" value="{{formData.description}}" data-field="description" bindinput="onInput" maxlength="1000"></textarea>
      </view>

      <view class="section-title">排班与时间</view>

      <view class="form-item required">
        <text class="label">活动日期</text>
        <picker mode="date" value="{{formData.activity_date}}" start="{{currentDate}}" bindchange="onDateChange" class="picker">
          <view class="picker-value">{{formData.activity_date || '请选择'}}</view>
        </picker>
      </view>

      <view class="form-row">
        <view class="form-item half required">
          <text class="label">开始时间</text>
          <picker mode="time" value="{{formData.start_time}}" bindchange="onStartTimeChange" class="picker">
            <view class="picker-value">{{formData.start_time || '请选择'}}</view>
          </picker>
        </view>
        <view class="form-item half required">
          <text class="label">结束时间</text>
          <picker mode="time" value="{{formData.end_time}}" bindchange="onEndTimeChange" class="picker">
            <view class="picker-value">{{formData.end_time || '请选择'}}</view>
          </picker>
        </view>
      </view>

      <view class="form-item">
        <text class="label">招募人数</text>
        <input class="input" type="number" placeholder="不填则不限" value="{{formData.max_participants}}" data-field="max_participants" bindinput="onInput"/>
      </view>

      <view class="form-tip">
        <text class="tip-text">创建后将自动发布（草稿 → 报名开放）；场次/岗位配置当前版本创建后不可在此修改。</text>
      </view>

    </view>
  </scroll-view>

  <view class="submit-section">
    <button class="submit-btn" bindtap="onSubmit" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '创建并发布活动'}}
    </button>
  </view>

</view>