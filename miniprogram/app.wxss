/* 全局CSS变量定义 */
:root {
  /* 主题色 */
  --color-primary: #FF6B35;      /* 品牌主色（你的橙色） */
  --color-elderly: #FF9800;      /* 老年活动橙色 */
  --color-parent-child: #2196F3; /* 亲子活动蓝色 */
  --color-public-welfare: #F44336; /* 公益活动红色 */
  --color-success: #4CAF50;      /* 成功绿色 */
  --color-warning: #FFC107;      /* 警告黄色 */
  
  /* 文本颜色 - 普通版 */
  --color-text-primary: #333333;
  --color-text-secondary: #666666;
  --color-text-light: #999999;
  --color-text-white: #FFFFFF;
  
  /* 背景色 */
  --color-bg-primary: #FFFFFF;
  --color-bg-secondary: #f7f7f7;  /* 保持你的背景色 */
  --color-bg-light: #FAFAFA;
  --color-bg-dark: #333333;
  
  /* 边框色 */
  --color-border: #E0E0E0;
  --color-border-light: #F0F0F0;
  
  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;
  --spacing-xxl: 64rpx;
  
  /* 字体大小 - 普通版 */
  --font-size-xs: 20rpx;
  --font-size-sm: 24rpx;
  --font-size-md: 28rpx;
  --font-size-lg: 32rpx;
  --font-size-xl: 36rpx;
  --font-size-xxl: 44rpx;
  
  /* 字体大小 - 老年版（通过类名覆盖） */
  --senior-font-size-xs: 36rpx;      /* 放大1.8倍 */
  --senior-font-size-sm: 43rpx;
  --senior-font-size-md: 50rpx;
  --senior-font-size-lg: 58rpx;
  --senior-font-size-xl: 65rpx;
  --senior-font-size-xxl: 80rpx;
  
  /* 圆角 */
  --border-radius-sm: 8rpx;
  --border-radius-md: 12rpx;
  --border-radius-lg: 16rpx;
  --border-radius-xl: 24rpx;
  --border-radius-round: 50%;
  
  /* 阴影 */
  --box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  --box-shadow-lg: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  --box-shadow-card: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  
  /* 过渡效果 */
  --transition-fast: all 0.2s ease;
  --transition-normal: all 0.3s ease;
  --transition-slow: all 0.5s ease;
  
  /* z-index 层级 */
  --z-index-dropdown: 1000;
  --z-index-sticky: 1020;
  --z-index-fixed: 1030;
  --z-index-modal: 1040;
  --z-index-popover: 1050;
  --z-index-tooltip: 1060;

  /* 为其他页面添加的变量 */
  /* 背景色 */
  --color-background: #f8f9fa;
  --color-card: #FFFFFF;

  /* 文字色 */
  --color-text: #333333;
  --color-text-secondary: #666666;

  /* 主题色 */
  --color-secondary: #4CAF50;

  /* 渐变 */
  --gradient-green: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);

  /* 间距 */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;

  /* 字体粗细 */
  --font-weight-normal: normal;
  --font-weight-medium: 500;
  --font-weight-bold: bold;

  /* 边框圆角 */
  --border-radius-circle: 50%;

  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);

  /* 行高 */
  --line-height-normal: 1.6;
}

/* 老年版样式覆盖 - 通过 .senior-mode 类名控制 */
.senior-mode {
  /* 字体放大1.8倍 */
  --font-size-xs: var(--senior-font-size-xs);
  --font-size-sm: var(--senior-font-size-sm);
  --font-size-md: var(--senior-font-size-md);
  --font-size-lg: var(--senior-font-size-lg);
  --font-size-xl: var(--senior-font-size-xl);
  --font-size-xxl: var(--senior-font-size-xxl);
  
  /* 超高对比度 */
  --color-text-primary: #000000 !important;
  --color-text-secondary: #333333 !important;
  --color-text-light: #555555 !important;
  --color-border: #000000 !important;
  
  /* 简化设计 - 移除阴影 */
  --box-shadow: none !important;
  --box-shadow-lg: none !important;
  --box-shadow-card: none !important;
  
  /* 简化圆角 */
  --border-radius-sm: 0 !important;
  --border-radius-md: 0 !important;
  --border-radius-lg: 0 !important;
  --border-radius-xl: 0 !important;
  
  /* 简化背景 */
  --color-bg-secondary: #F0F0F0 !important;
  
  /* 字体加粗，更易阅读 */
  font-weight: 500 !important;
}

/* 页面基础样式 */
page {
  background-color: var(--color-bg-secondary);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', STHeiti, 'Microsoft Yahei', Tahoma, Simsun, sans-serif;
  color: var(--color-text-primary);
  line-height: 1.6;
  font-size: var(--font-size-md);
  transition: var(--transition-normal);
}

/* 老年版页面额外样式 */
.senior-mode page {
  font-weight: 500;
  line-height: 1.8;
}

/* 通用容器样式 */
.container {
  padding: var(--spacing-lg);
}

.senior-mode .container {
  padding: var(--spacing-xl);
}

/* 卡片通用样式 */
.card {
  background: var(--color-bg-primary);
  border-radius: var(--border-radius-lg);
  box-shadow: var(--box-shadow-card);
  margin: var(--spacing-md) var(--spacing-lg);
  padding: var(--spacing-lg);
  transition: var(--transition-normal);
}

.senior-mode .card {
  border: 2rpx solid var(--color-border) !important;
  box-shadow: none !important;
  margin: var(--spacing-lg) var(--spacing-xl);
  padding: var(--spacing-xl);
}

/* 大按钮样式（老年版专用） */
.senior-btn {
  display: block;
  width: 100%;
  padding: var(--spacing-xl) var(--spacing-xxl);
  font-size: var(--font-size-xl);
  font-weight: 600;
  text-align: center;
  border: 3rpx solid var(--color-border);
  background: var(--color-bg-primary);
  color: var(--color-text-primary);
  margin: var(--spacing-lg) 0;
  transition: var(--transition-normal);
}

.senior-btn:active {
  background: var(--color-border-light);
}

/* 文字颜色类 */
.text-primary { color: var(--color-primary); }
.text-elderly { color: var(--color-elderly); }
.text-parent-child { color: var(--color-parent-child); }
.text-public-welfare { color: var(--color-public-welfare); }
.text-success { color: var(--color-success); }
.text-warning { color: var(--color-warning); }
.text-white { color: var(--color-text-white); }

/* 背景颜色类 */
.bg-primary { background-color: var(--color-primary); }
.bg-elderly { background-color: var(--color-elderly); }
.bg-parent-child { background-color: var(--color-parent-child); }
.bg-public-welfare { background-color: var(--color-public-welfare); }
.bg-success { background-color: var(--color-success); }

/* 字体大小类 */
.text-xs { font-size: var(--font-size-xs); }
.text-sm { font-size: var(--font-size-sm); }
.text-md { font-size: var(--font-size-md); }
.text-lg { font-size: var(--font-size-lg); }
.text-xl { font-size: var(--font-size-xl); }
.text-xxl { font-size: var(--font-size-xxl); }

/* 字体粗细类 */
.font-normal { font-weight: normal; }
.font-medium { font-weight: 500; }
.font-bold { font-weight: bold; }
.font-bolder { font-weight: 700; }

/* 布局工具类 */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-row { flex-direction: row; }
.items-start { align-items: flex-start; }
.items-center { align-items: center; }
.items-end { align-items: flex-end; }
.justify-start { justify-content: flex-start; }
.justify-center { justify-content: center; }
.justify-end { justify-content: flex-end; }
.justify-between { justify-content: space-between; }
.justify-around { justify-content: space-around; }
.flex-wrap { flex-wrap: wrap; }
.flex-nowrap { flex-wrap: nowrap; }
.flex-1 { flex: 1; }
.flex-auto { flex: auto; }
.flex-none { flex: none; }

/* 间距工具类 */
.m-0 { margin: 0; }
.m-xs { margin: var(--spacing-xs); }
.m-sm { margin: var(--spacing-sm); }
.m-md { margin: var(--spacing-md); }
.m-lg { margin: var(--spacing-lg); }
.m-xl { margin: var(--spacing-xl); }

.mt-0 { margin-top: 0; }
.mt-xs { margin-top: var(--spacing-xs); }
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }
.mt-xl { margin-top: var(--spacing-xl); }

.mb-0 { margin-bottom: 0; }
.mb-xs { margin-bottom: var(--spacing-xs); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.mb-lg { margin-bottom: var(--spacing-lg); }
.mb-xl { margin-bottom: var(--spacing-xl); }

.p-0 { padding: 0; }
.p-xs { padding: var(--spacing-xs); }
.p-sm { padding: var(--spacing-sm); }
.p-md { padding: var(--spacing-md); }
.p-lg { padding: var(--spacing-lg); }
.p-xl { padding: var(--spacing-xl); }

.pt-xs { padding-top: var(--spacing-xs); }
.pt-sm { padding-top: var(--spacing-sm); }
.pt-md { padding-top: var(--spacing-md); }
.pt-lg { padding-top: var(--spacing-lg); }

.pb-xs { padding-bottom: var(--spacing-xs); }
.pb-sm { padding-bottom: var(--spacing-sm); }
.pb-md { padding-bottom: var(--spacing-md); }
.pb-lg { padding-bottom: var(--spacing-lg); }

/* 边框工具类 */
.border { border: 1rpx solid var(--color-border); }
.border-t { border-top: 1rpx solid var(--color-border); }
.border-b { border-bottom: 1rpx solid var(--color-border); }
.border-l { border-left: 1rpx solid var(--color-border); }
.border-r { border-right: 1rpx solid var(--color-border); }

/* 圆角工具类 */
.rounded-sm { border-radius: var(--border-radius-sm); }
.rounded-md { border-radius: var(--border-radius-md); }
.rounded-lg { border-radius: var(--border-radius-lg); }
.rounded-xl { border-radius: var(--border-radius-xl); }
.rounded-full { border-radius: var(--border-radius-round); }

/* 阴影工具类 */
.shadow-sm { box-shadow: var(--box-shadow); }
.shadow-md { box-shadow: var(--box-shadow-lg); }

/* 文本对齐 */
.text-left { text-align: left; }
.text-center { text-align: center; }
.text-right { text-align: right; }

/* 显示隐藏 */
.hidden { display: none !important; }
.block { display: block !important; }
.inline-block { display: inline-block !important; }
.inline { display: inline !important; }

/* 定位 */
.relative { position: relative; }
.absolute { position: absolute; }
.fixed { position: fixed; }
.sticky { position: sticky; }

/* 宽度高度 */
.w-full { width: 100%; }
.h-full { height: 100%; }
.min-h-screen { min-height: 100vh; }

/* 溢出处理 */
.overflow-hidden { overflow: hidden; }
.overflow-auto { overflow: auto; }
.overflow-x-auto { overflow-x: auto; }
.overflow-y-auto { overflow-y: auto; }

/* 透明度 */
.opacity-50 { opacity: 0.5; }
.opacity-75 { opacity: 0.75; }
.opacity-100 { opacity: 1; }

/* 光标 */
.cursor-pointer { cursor: pointer; }
.cursor-default { cursor: default; }

/* 禁用状态 */
.disabled {
  opacity: 0.5;
  cursor: not-allowed;
  pointer-events: none;
}

/* 滚动条样式（仅普通版） */
::-webkit-scrollbar {
  width: 6rpx;
  height: 6rpx;
}

::-webkit-scrollbar-track {
  background: var(--color-bg-light);
  border-radius: 3rpx;
}

::-webkit-scrollbar-thumb {
  background: var(--color-text-light);
  border-radius: 3rpx;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--color-text-secondary);
}

/* 老年版移除滚动条样式 */
.senior-mode ::-webkit-scrollbar {
  width: 12rpx !important;
  height: 12rpx !important;
}

.senior-mode ::-webkit-scrollbar-thumb {
  background: var(--color-text-primary) !important;
}